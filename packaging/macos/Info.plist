<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modèle utilisé par build-app.sh : @VERSION@ est remplacé par la version de Cargo.toml. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>MagicPlus</string>
  <key>CFBundleDisplayName</key>
  <string>MagicPlus</string>
  <key>CFBundleIdentifier</key>
  <string>com.magicplus.app</string>
  <key>CFBundleExecutable</key>
  <string>magicplus</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>fr</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>MagicPlus trouve vos autres appareils et leur envoie fichiers et presse-papiers sur le réseau local.</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>MagicPlus utilise le Bluetooth pour joindre vos ordinateurs appairés quand il n'y a pas de réseau commun.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>MagicPlus demande à System Events de copier la sélection pour le raccourci « copier et envoyer ».</string>
</dict>
</plist>
