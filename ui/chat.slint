// Page « Discussions » de l'interface Slint (Windows), dans l'esprit de Discord :
// conversations à gauche ; à droite, messages groupés par auteur (avatar, nom, heure),
// bulles en Markdown, réponses, réactions, modification, pièces jointes, GIF animés,
// autocollants, accusés de lecture et « en train d'écrire ». Rien ne dépend d'Internet.
// Les données viennent de Rust (src/ui_slint/chat.rs) par le global `ChatData`.

import { Button, LineEdit, CheckBox, ScrollView, ListView, TextEdit, ProgressIndicator } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MarkdownView, BlockItem } from "markdown.slint";
import { Avatar, ProfileCard, ProfileItem } from "profile.slint";
import { CanvasPane, CanvasData } from "canvas.slint";

export struct ConversationItem {
    id: string,
    title: string,
    preview: string,
    unread: int,
    group: bool,
    online: bool,
    // Présence de l'autre (discussion à deux) : 0 hors ligne, 1 en ligne, 2 inactif, 3 ne pas déranger.
    presence: int,
    typing: bool,
    selected: bool,
    initials: string,
    color: color,
    photo: image,
    has-photo: bool,
}

export struct ReactionItem {
    emoji: string,
    count: int,
    mine: bool,
    names: string,
    // Émoji personnalisé : son image (animée si `frames` en a plusieurs).
    custom: bool,
    image: image,
    frames: [image],
    frame-ms: int,
}

// Case du sélecteur d'émojis : un émoji Unicode (`text`) ou personnalisé (`image`).
export struct EmojiCell {
    text: string,
    image: image,
    frames: [image],
    frame-ms: int,
    // Ce qui est envoyé (texte Unicode ou `<:nom:id>`), nom affiché dans l'aperçu.
    token: string,
    name: string,
    favorite: bool,
    // Émoji personnalisé à nous (supprimable).
    mine: bool,
}

// Ligne du sélecteur : un titre de section, ou des cases.
export struct EmojiRow {
    header: string,
    cells: [EmojiCell],
}

// GIF de GIPHY dans le sélecteur : aperçu animé.
export struct GifItem {
    id: string,
    title: string,
    image: image,
    frames: [image],
    frame-ms: int,
    favorite: bool,
}

// Morceau d'un message avec émojis personnalisés dans le texte.
export struct InlinePiece {
    text: string,
    is-image: bool,
    image: image,
    frames: [image],
    frame-ms: int,
}

export struct AttachmentItem {
    // 0 = image affichée, 1 = fichier à ouvrir, 2 = en attente ou en cours de réception, 3 = image en chargement
    kind: int,
    name: string,
    label: string,
    path: string,
    image: image,
    frames: [image],
    frame-ms: int,
    width: length,
    height: length,
    progress: float,
}

export struct MessageItem {
    id: string,
    author: string,
    author-id: string,
    photo: image,
    has-photo: bool,
    // Photo animée (GIF) : animée au survol du message, comme Discord.
    photo-frames: [image],
    photo-frame-ms: int,
    initials: string,
    color: color,
    mine: bool,
    system: bool,
    header: bool,
    time: string,
    blocks: [BlockItem],
    // Texte brut (émojis seuls affichés en grand).
    plain: string,
    has-text: bool,
    has-code: bool,
    // Épinglé par (vide sinon), auteur d'origine d'un message transféré (vide sinon).
    pinned-by: string,
    forwarded: string,
    deleted: bool,
    edited: bool,
    jumbo: bool,
    // Émojis seuls, dont des personnalisés : affichés en grand, en images.
    big-emojis: [EmojiCell],
    // Texte simple avec émojis personnalisés : morceaux de texte et images, sur une ligne.
    inline: [InlinePiece],
    // Réponse à un message (comme Discord : petite photo, @auteur et extrait au-dessus).
    has-reply: bool,
    reply: string,
    reply-author: string,
    reply-author-id: string,
    reply-photo: image,
    reply-has-photo: bool,
    reply-initials: string,
    reply-color: color,
    attachments: [AttachmentItem],
    reactions: [ReactionItem],
    status: string,
}

export struct ChoiceItem {
    id: string,
    name: string,
    checked: bool,
}

export struct StickerItem {
    id: string,
    image: image,
    frames: [image],
    frame-ms: int,
}

export struct MemberItem {
    id: string,
    name: string,
    state: string,
    // 0 : pas ami (« Ajouter en ami »), 1 : vous, 2 : ami, 3 : demande envoyée, 4 : il vous demande.
    friend: int,
}

export struct PinItem {
    id: string,
    author: string,
    time: string,
    text: string,
}

export global ChatData {
    // ---- liste des conversations
    in property <[ConversationItem]> conversations;
    in property <int> unread;
    in property <[ChoiceItem]> direct-choices;

    // ---- conversation affichée
    in property <bool> has-conversation;
    in property <string> title;
    in property <string> subtitle;
    in property <string> initials;
    in property <color> color;
    in property <bool> is-group;
    in property <bool> online;
    in property <image> photo;
    in property <bool> has-photo;
    // Conversation à deux : l'autre appareil (pour ouvrir son profil).
    in property <string> peer-id;
    in property <bool> is-creator;
    in property <bool> closed;
    in property <bool> history-start;
    in property <[MessageItem]> messages;
    in property <[MemberItem]> members;
    in property <string> typing;

    // ---- zone de saisie
    in-out property <string> draft;
    in property <string> banner;
    in property <[string]> pending;
    in property <int> pending-more;
    in property <[StickerItem]> stickers;

    // ---- demandes de Rust à l'interface
    in-out property <int> scroll-request;
    in-out property <int> focus-request;
    // Carte de profil à afficher (remplie par Rust avant `profile-request`).
    in property <ProfileItem> profile;
    in-out property <int> profile-request;
    // Animation des GIF : avance de 1 toutes les 50 ms.
    in property <int> tick;

    // Présence de l'autre (discussion à deux).
    in property <int> presence;

    // ---- GIF de GIPHY (recherche, tendances, favoris)
    in property <[GifItem]> gifs;
    in property <bool> giphy-ready;
    in property <string> gif-status;
    in-out property <string> gif-query;
    // 0 : tendances ou recherche ; 1 : favoris.
    in-out property <int> gif-tab;
    // Ouvre le sélecteur de GIF (captures d'écran de développement).
    in property <int> gif-request;
    callback gif-search();
    callback gif-send(string);
    callback gif-favorite(string);
    callback gif-save-key(string);
    callback open-giphy-signup();

    // ---- sélecteur d'émojis (écrire et réagir)
    in property <[EmojiRow]> emoji-rows;
    in property <[string]> emoji-tabs;
    in-out property <int> emoji-tab;
    in-out property <string> emoji-search;
    // Ouvre le sélecteur d'émojis de la zone de saisie (captures d'écran de développement).
    in property <int> emoji-request;
    callback emoji-filter-changed();
    // `reaction` : réagir au message `actions-index` (sinon : écrire).
    callback emoji-picked(EmojiCell, bool);
    callback emoji-favorite(EmojiCell);
    callback emoji-add();
    callback emoji-remove(EmojiCell);

    // ---- boîtes de dialogue : 0 aucune, 1 nouveau groupe, 2 ajouter des membres, 3 renommer,
    // 4 supprimer un message, 5 quitter le groupe
    in-out property <int> dialog;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <string> dialog-error;
    in-out property <string> dialog-name;
    in property <[ChoiceItem]> choices;

    callback select(int);
    callback send();
    callback typing-changed();
    callback paste-media() -> bool;
    callback cancel-banner() -> bool;
    callback edit-last() -> bool;
    callback message-action(int, string);
    callback toggle-reaction(int, string);
    callback open-path(string);
    callback open-link(string);
    callback attach();
    callback remove-pending(int);
    callback open-direct(string);
    callback new-group();
    callback add-members();
    callback rename();
    callback leave();
    // Demande d'ami à un membre du groupe ; accepter la sienne.
    callback friend-request(string);
    callback friend-accept(string);
    callback toggle-choice(int, bool);
    callback dialog-accepted();
    callback send-sticker(string);
    callback add-sticker();
    callback remove-sticker(string);
    callback show-profile(string);
    callback edit-profile();

    // ---- menus stylisés
    in-out property <MessageItem> actions-message;
    in-out property <int> actions-index;
    in-out property <length> actions-x;
    in-out property <length> actions-y;
    in-out property <int> actions-request;
    in property <[ChoiceItem]> forward-choices;
    in property <[PinItem]> pins;
    callback prepare-forward();
    callback forward(int, string);
    callback prepare-pins();
    callback unpin(string);
}

// ------------------------------------------------------------------ petits éléments

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 34px;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <color> tint: Theme.subtle;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: 6px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.nav-selected : touch.has-hover || root.active ? Theme.nav-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Image {
        source: root.icon;
        colorize: (touch.has-hover || root.active) && root.enabled ? Theme.text : root.tint;
        width: root.size * 0.56;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component EmojiButton inherits Rectangle {
    in property <string> emoji;
    in property <length> size: 30px;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: 6px;
    background: touch.pressed ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;

    Text {
        text: root.emoji;
        font-size: root.size * 0.56;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Une image animée (GIF) ou fixe : `frames` contient les images d'un GIF, `image` la première.
component AnimatedImage inherits Image {
    in property <image> still;
    in property <[image]> frames;
    in property <int> frame-ms: 100;
    source: root.frames.length > 1 ? root.frames[Math.mod(Math.floor(ChatData.tick * 50 / Math.max(root.frame-ms, 20)), root.frames.length)] : root.still;
    image-fit: contain;
}

// Une case du sélecteur : émoji Unicode en texte, ou image (animée) d'un émoji personnalisé.
component EmojiTile inherits Rectangle {
    in property <EmojiCell> cell;
    in property <length> size: 40px;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    callback right-clicked;
    width: root.size;
    height: root.size;
    border-radius: 6px;
    background: touch.pressed ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;

    if root.cell.text != "": Text {
        text: root.cell.text;
        font-size: root.size * 0.6;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.cell.text == "": AnimatedImage {
        still: root.cell.image;
        frames: root.cell.frames;
        frame-ms: root.cell.frame-ms;
        width: root.size * 0.7;
        height: root.size * 0.7;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.right-clicked();
            }
        }
    }
}

// Sélecteur d'émojis complet, comme Discord : recherche, favoris et récents, émojis
// personnalisés, catégories. Clic : choisir ; clic droit (ou étoile) : favori.
component EmojiPicker inherits Rectangle {
    callback picked(EmojiCell);
    property <EmojiCell> preview;
    property <bool> has-preview;
    background: Theme.popup;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            LineEdit {
                text <=> ChatData.emoji-search;
                placeholder-text: "Rechercher (en anglais : smile, cat…)";
                horizontal-stretch: 1;
                edited => {
                    ChatData.emoji-filter-changed();
                }
            }
            IconButton {
                icon: @image-url("icons/plus.svg");
                tint: Theme.accent;
                clicked => {
                    ChatData.emoji-add();
                }
            }
        }

        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            for tab[i] in ChatData.emoji-tabs: Rectangle {
                width: 32px;
                height: 30px;
                border-radius: 6px;
                background: ChatData.emoji-tab == i && ChatData.emoji-search == "" ? Theme.nav-selected : tab-touch.has-hover ? Theme.nav-hover : transparent;
                Text {
                    text: tab;
                    font-size: 16px;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                tab-touch := TouchArea {
                    clicked => {
                        ChatData.emoji-tab = i;
                        ChatData.emoji-search = "";
                        ChatData.emoji-filter-changed();
                    }
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row in ChatData.emoji-rows: VerticalLayout {
                if row.header != "": Text {
                    text: row.header;
                    color: Theme.subtle;
                    font-size: 11px;
                    font-weight: 700;
                    min-height: 26px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if row.cells.length > 0: HorizontalLayout {
                    alignment: start;
                    for cell in row.cells: EmojiTile {
                        cell: cell;
                        clicked => {
                            root.picked(cell);
                        }
                        right-clicked => {
                            ChatData.emoji-favorite(cell);
                        }
                        changed hovered => {
                            if self.hovered {
                                root.preview = cell;
                                root.has-preview = true;
                            }
                        }
                    }
                }
            }
        }

        // Aperçu de l'émoji survolé : nom, favori, suppression (émojis à nous).
        Rectangle {
            height: 44px;
            border-radius: 8px;
            background: Theme.bubble.with-alpha(0.6);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 8px;
                if root.has-preview: VerticalLayout {
                    alignment: center;
                    EmojiTile {
                        cell: root.preview;
                        size: 36px;
                    }
                }
                Text {
                    text: root.has-preview ? root.preview.name : "Clic droit sur un émoji : favori";
                    color: root.has-preview ? Theme.text : Theme.subtle;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.has-preview: Rectangle {
                    width: 34px;
                    star-touch := TouchArea {
                        clicked => {
                            ChatData.emoji-favorite(root.preview);
                            root.preview.favorite = !root.preview.favorite;
                        }
                    }
                    Text {
                        text: root.preview.favorite ? "★" : "☆";
                        color: root.preview.favorite ? Theme.warning : star-touch.has-hover ? Theme.text : Theme.subtle;
                        font-size: 20px;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.has-preview && root.preview.mine: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/delete.svg");
                        tint: Theme.danger;
                        clicked => {
                            ChatData.emoji-remove(root.preview);
                            root.has-preview = false;
                        }
                    }
                }
            }
        }
    }
}

// Sélecteur de GIF (GIPHY) : recherche, tendances, favoris (étoile sur chaque GIF).
component GifPicker inherits Rectangle {
    callback sent;
    property <string> key-draft;
    property <length> tile-w: (self.width - 16px - 12px - 8px) / 3;
    background: Theme.popup;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        if !ChatData.giphy-ready: VerticalLayout {
            spacing: 8px;
            padding: 6px;
            Text {
                text: "Recherche de GIF avec GIPHY";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "Il faut une clé d'API GIPHY (gratuite). Créez-la sur developers.giphy.com (« Create an API Key », type API), puis collez-la ici. C'est le seul usage d'Internet avec les mises à jour : les GIF envoyés partent ensuite directement vers vos contacts.";
                color: Theme.subtle;
                font-size: 12.5px;
                wrap: word-wrap;
            }
            Button {
                text: "Créer une clé sur GIPHY…";
                clicked => {
                    ChatData.open-giphy-signup();
                }
            }
            HorizontalLayout {
                spacing: 6px;
                LineEdit {
                    text <=> root.key-draft;
                    placeholder-text: "Clé d'API GIPHY";
                    horizontal-stretch: 1;
                    accepted => {
                        ChatData.gif-save-key(root.key-draft);
                    }
                }
                Button {
                    text: "Enregistrer";
                    primary: true;
                    enabled: root.key-draft != "";
                    clicked => {
                        ChatData.gif-save-key(root.key-draft);
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
            }
        }

        if ChatData.giphy-ready: HorizontalLayout {
            spacing: 6px;
            LineEdit {
                text <=> ChatData.gif-query;
                placeholder-text: "Rechercher sur GIPHY";
                horizontal-stretch: 1;
                accepted => {
                    ChatData.gif-tab = 0;
                    ChatData.gif-search();
                }
            }
        }

        if ChatData.giphy-ready: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for tab[i] in [ChatData.gif-query == "" ? "🔥 Tendances" : "🔎 Résultats", "⭐ Favoris"]: Rectangle {
                width: label.preferred-width + 20px;
                height: 28px;
                border-radius: 6px;
                background: ChatData.gif-tab == i ? Theme.nav-selected : tab-touch.has-hover ? Theme.nav-hover : transparent;
                label := Text {
                    text: tab;
                    color: ChatData.gif-tab == i ? Theme.text : Theme.subtle;
                    font-size: 12.5px;
                    font-weight: 600;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                tab-touch := TouchArea {
                    clicked => {
                        ChatData.gif-tab = i;
                        ChatData.gif-search();
                    }
                }
            }
        }

        if ChatData.giphy-ready: ScrollView {
            vertical-stretch: 1;
            content-height: Math.ceil(ChatData.gifs.length / 3) * (root.tile-w * 0.8 + 4px);
            for gif[i] in ChatData.gifs: Rectangle {
                x: Math.mod(i, 3) * (root.tile-w + 4px);
                y: Math.floor(i / 3) * (root.tile-w * 0.8 + 4px);
                width: root.tile-w;
                height: root.tile-w * 0.8;
                border-radius: 6px;
                background: Theme.bubble;
                clip: true;
                AnimatedImage {
                    still: gif.image;
                    frames: gif.frames;
                    frame-ms: gif.frame-ms;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
                gif-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        ChatData.gif-send(gif.id);
                        root.sent();
                    }
                }
                if gif-touch.has-hover || gif.favorite: Rectangle {
                    x: parent.width - 30px;
                    y: 4px;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: #000000a0;
                    Text {
                        text: gif.favorite ? "★" : "☆";
                        color: gif.favorite ? #ffd43b : #ffffff;
                        font-size: 15px;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            ChatData.gif-favorite(gif.id);
                        }
                    }
                }
            }
        }

        if ChatData.giphy-ready: HorizontalLayout {
            Text {
                text: ChatData.gif-status;
                color: Theme.subtle;
                font-size: 11px;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: "Powered by GIPHY";
                color: Theme.subtle;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.card-border;
}

component ConversationRow inherits Rectangle {
    in property <ConversationItem> item;
    callback clicked;
    height: 58px;
    border-radius: 6px;
    background: root.item.selected ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Avatar {
                initials: root.item.initials;
                tint: root.item.color;
                photo: root.item.photo;
                has-photo: root.item.has-photo;
                size: 38px;
                show-presence: !root.item.group;
                online: root.item.online;
                presence: root.item.presence;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: root.item.unread > 0 ? 700 : 600;
                overflow: elide;
            }
            Text {
                text: root.item.typing ? "écrit…" : root.item.preview;
                color: root.item.typing ? Theme.accent : root.item.unread > 0 ? Theme.text : Theme.subtle;
                font-size: 12px;
                overflow: elide;
            }
        }

        if root.item.unread > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                min-width: 20px;
                preferred-width: count.preferred-width + 12px;
                border-radius: 10px;
                background: Theme.badge;
                count := Text {
                    text: root.item.unread > 99 ? "99+" : root.item.unread;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 700;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component ReactionPill inherits Rectangle {
    in property <ReactionItem> reaction;
    callback clicked;
    height: 26px;
    min-width: label.preferred-width + 18px;
    preferred-width: label.preferred-width + 18px;
    border-radius: 8px;
    background: root.reaction.mine ? Theme.accent.with-alpha(0.16) : Theme.bubble;
    border-width: 1px;
    border-color: root.reaction.mine ? Theme.accent : touch.has-hover ? Theme.card-border : transparent;

    if !root.reaction.custom: Text {
        text: root.reaction.emoji + " " + root.reaction.count;
        color: root.reaction.mine ? Theme.accent : Theme.text;
        font-size: 13px;
        font-weight: 600;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.reaction.custom: HorizontalLayout {
        alignment: center;
        spacing: 5px;
        AnimatedImage {
            still: root.reaction.image;
            frames: root.reaction.frames;
            frame-ms: root.reaction.frame-ms;
            width: 18px;
            height: 18px;
            y: 4px;
        }
        Text {
            text: root.reaction.count;
            color: root.reaction.mine ? Theme.accent : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    // Largeur mesurée (texte, ou image + nombre).
    label := Text {
        text: root.reaction.custom ? "WW " + root.reaction.count : root.reaction.emoji + " " + root.reaction.count;
        font-size: 13px;
        font-weight: 600;
        visible: false;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}


component FileCard inherits Rectangle {
    in property <AttachmentItem> item;
    callback open(string);
    width: 320px;
    height: 56px;
    border-radius: 8px;
    background: Theme.card;
    border-width: 1px;
    border-color: touch.has-hover && root.item.kind == 1 ? Theme.accent : Theme.card-border;

    touch := TouchArea {
        enabled: root.item.kind == 1;
        mouse-cursor: root.item.kind == 1 ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.open(root.item.path);
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.item.kind == 2 ? @image-url("icons/download.svg") : @image-url("icons/file.svg");
                colorize: root.item.kind == 2 ? Theme.neutral : Theme.accent;
                width: 26px;
                height: 26px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.item.name;
                color: root.item.kind == 1 ? Theme.accent : Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.label;
                color: Theme.subtle;
                font-size: 11px;
                overflow: elide;
            }
            if root.item.kind == 2 && root.item.progress > 0: ProgressIndicator {
                progress: root.item.progress;
                height: 4px;
            }
        }
    }
}

component PendingChip inherits Rectangle {
    in property <string> name;
    callback remove;
    height: 30px;
    border-radius: 6px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    preferred-width: chip.preferred-width;
    max-width: 220px;

    chip := HorizontalLayout {
        padding-left: 10px;
        padding-right: 2px;
        spacing: 6px;
        Image {
            source: @image-url("icons/attach.svg");
            colorize: Theme.subtle;
            width: 14px;
            y: 8px;
            height: 14px;
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/close.svg");
                size: 24px;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

// ------------------------------------------------------------------ messages

component SystemRow inherits Rectangle {
    in property <MessageItem> message;
    preferred-height: 34px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: "— " + root.message.author + "  ·  " + root.message.time + " —";
            color: Theme.subtle;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Ligne de menu stylisée : icône, texte, survol ; rouge pour une action dangereuse.
component MenuRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? (root.danger ? Theme.danger.with-alpha(0.14) : Theme.accent.with-alpha(0.14)) : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.danger ? Theme.danger : touch.has-hover && root.enabled ? Theme.accent : Theme.subtle;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : root.enabled ? Theme.text : Theme.subtle;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
}

component MenuTitle inherits Text {
    color: Theme.subtle;
    font-size: 10.5px;
    font-weight: 700;
    height: 22px;
    vertical-alignment: center;
}

component MenuLine inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.card-border;
    }
}

// Fond commun des menus : carte arrondie avec ombre.
component MenuPanel inherits Rectangle {
    background: Theme.popup;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000050;
}

component MessageRow inherits Rectangle {
    in property <MessageItem> message;
    in property <int> index;
    in property <bool> can-act;
    in property <length> bubble-max: 520px;
    preferred-height: body.preferred-height;
    min-height: body.min-height;
    background: hover.has-hover ? Theme.row-hover : transparent;

    // Menu d'actions stylisé (dessiné par la page), à la position donnée (fenêtre).
    function open-actions(x: length, y: length) {
        ChatData.actions-message = root.message;
        ChatData.actions-index = root.index;
        ChatData.actions-x = x;
        ChatData.actions-y = y;
        ChatData.actions-request += 1;
    }

    hover := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down && !root.message.deleted {
                root.open-actions(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        body := VerticalLayout {
            padding-left: 16px;
            padding-right: 24px;
            padding-top: root.message.header ? 14px : 1px;
            padding-bottom: 1px;
            spacing: 2px;

            // Réponse, comme Discord : un trait courbe part de la photo vers la petite photo
            // de l'auteur cité, son @nom et le début de son message.
            if root.message.has-reply: Rectangle {
                height: 20px;
                Path {
                    x: 18px;
                    y: 9px;
                    width: 30px;
                    height: 13px;
                    viewbox-width: 30;
                    viewbox-height: 13;
                    commands: "M 1 13 L 1 6 Q 1 1 6 1 L 30 1";
                    stroke: Theme.reply-line;
                    stroke-width: 2px;
                    fill: transparent;
                }
                HorizontalLayout {
                    x: 52px;
                    width: parent.width - 52px;
                    spacing: 5px;
                    alignment: start;
                    if root.message.reply-author != "": VerticalLayout {
                        alignment: center;
                        Avatar {
                            initials: root.message.reply-initials;
                            tint: root.message.reply-color;
                            photo: root.message.reply-photo;
                            has-photo: root.message.reply-has-photo;
                            size: 16px;
                        }
                    }
                    if root.message.reply-author != "": Text {
                        text: "@" + root.message.reply-author;
                        color: Theme.text.with-alpha(0.85);
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                ChatData.show-profile(root.message.reply-author-id);
                            }
                        }
                    }
                    Text {
                        text: root.message.reply;
                        color: Theme.subtle;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            HorizontalLayout {
                spacing: 14px;

                if root.message.header: VerticalLayout {
                    alignment: start;
                    Avatar {
                        initials: root.message.initials;
                        tint: root.message.color;
                        photo: root.message.photo;
                        has-photo: root.message.has-photo;
                        frames: root.message.photo-frames;
                        frame-ms: root.message.photo-frame-ms;
                        animate: hover.has-hover;
                        size: 38px;
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                ChatData.show-profile(root.message.author-id);
                            }
                        }
                    }
                }
                if !root.message.header: Rectangle {
                    width: 38px;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;

                    if root.message.header: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: root.message.author;
                            color: root.message.mine ? Theme.accent : Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.message.time;
                            color: Theme.subtle;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    if root.message.forwarded != "": Text {
                        text: "↪ Transféré · message de " + root.message.forwarded;
                        color: Theme.subtle;
                        font-size: 11.5px;
                        font-italic: true;
                    }
                    // Texte sans bulle, sur toute la largeur (comme Discord).
                    if root.message.deleted || root.message.has-text: VerticalLayout {
                        spacing: 2px;
                        if root.message.deleted: Text {
                            text: "Message supprimé";
                            color: Theme.subtle;
                            font-size: 13px;
                            font-italic: true;
                        }
                        if !root.message.deleted && root.message.big-emojis.length > 0: HorizontalLayout {
                        alignment: start;
                        spacing: 4px;
                        for cell in root.message.big-emojis: Rectangle {
                            width: 48px;
                            height: 48px;
                            if cell.text != "": Text {
                                text: cell.text;
                                font-size: 34px;
                                vertical-alignment: center;
                            }
                            if cell.text == "": AnimatedImage {
                                still: cell.image;
                                frames: cell.frames;
                                frame-ms: cell.frame-ms;
                                width: 48px;
                                height: 48px;
                            }
                        }
                    }
                    if !root.message.deleted && root.message.inline.length > 0: HorizontalLayout {
                        alignment: start;
                        spacing: 0px;
                        for piece in root.message.inline: HorizontalLayout {
                            if !piece.is-image: Text {
                                text: piece.text;
                                color: Theme.text;
                                font-size: 14px;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            if piece.is-image: AnimatedImage {
                                still: piece.image;
                                frames: piece.frames;
                                frame-ms: piece.frame-ms;
                                width: 22px;
                                height: 22px;
                            }
                        }
                    }
                    if !root.message.deleted && root.message.jumbo && root.message.big-emojis.length == 0: Text {
                            text: root.message.plain;
                            font-size: 34px;
                        }
                        if !root.message.deleted && !root.message.jumbo && root.message.big-emojis.length == 0 && root.message.inline.length == 0: MarkdownView {
                            blocks: root.message.blocks;
                            link-clicked(url) => {
                                ChatData.open-link(url);
                            }
                        }
                        if root.message.edited && !root.message.deleted: Text {
                            text: "(modifié)";
                            color: Theme.subtle;
                            font-size: 10px;
                        }
                    }

                    for item in root.message.attachments: HorizontalLayout {
                        alignment: start;
                        if item.kind == 0: Rectangle {
                            width: item.width;
                            height: item.height;
                            border-radius: 8px;
                            clip: true;
                            AnimatedImage {
                                still: item.image;
                                frames: item.frames;
                                frame-ms: item.frame-ms;
                                width: parent.width;
                                height: parent.height;
                            }
                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    ChatData.open-path(item.path);
                                }
                            }
                        }
                        if item.kind == 3: Rectangle {
                            width: item.width;
                            height: item.height;
                            border-radius: 8px;
                            background: Theme.bubble;
                            Text {
                                text: "Chargement…";
                                color: Theme.subtle;
                                font-size: 12px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if item.kind == 1 || item.kind == 2: FileCard {
                            item: item;
                            open(path) => {
                                ChatData.open-path(path);
                            }
                        }
                    }

                    if root.message.reactions.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for reaction in root.message.reactions: ReactionPill {
                            reaction: reaction;
                            clicked => {
                                if root.can-act {
                                    ChatData.toggle-reaction(root.index, reaction.emoji);
                                }
                            }
                        }
                    }

                    if root.message.pinned-by != "": Text {
                        text: "📌 Épinglé par " + root.message.pinned-by;
                        color: Theme.subtle;
                        font-size: 11px;
                    }
                    if root.message.status != "": Text {
                        text: root.message.status;
                        color: Theme.subtle;
                        font-size: 11px;
                    }
                }
        
            }
        }

        // Barre d'actions au survol, comme sur Discord.
        if hover.has-hover && root.can-act && !root.message.deleted: Rectangle {
            x: parent.width - self.width - 18px;
            y: root.message.header ? 4px : -6px;
            width: tools.preferred-width;
            height: 34px;
            border-radius: 8px;
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.card-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #0000002a;

            tools := HorizontalLayout {
                padding: 2px;
                EmojiButton {
                    emoji: "👍";
                    clicked => {
                        ChatData.message-action(root.index, "react:👍");
                    }
                }
                EmojiButton {
                    emoji: "❤️";
                    clicked => {
                        ChatData.message-action(root.index, "react:❤️");
                    }
                }
                EmojiButton {
                    emoji: "😂";
                    clicked => {
                        ChatData.message-action(root.index, "react:😂");
                    }
                }
                IconButton {
                    icon: @image-url("icons/reply.svg");
                    size: 30px;
                    clicked => {
                        ChatData.message-action(root.index, "reply");
                    }
                }
                if root.message.mine && root.message.has-text: IconButton {
                    icon: @image-url("icons/edit.svg");
                    size: 30px;
                    clicked => {
                        ChatData.message-action(root.index, "edit");
                    }
                }
                IconButton {
                    icon: @image-url("icons/more.svg");
                    size: 30px;
                    clicked => {
                        root.open-actions(self.absolute-position.x - 210px, self.absolute-position.y + 32px);
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ page

// Zone de saisie : pièce jointe, texte (Entrée envoie, Maj+Entrée va à la ligne, Ctrl+V colle
// aussi les images et les fichiers), émojis, autocollants, envoi.
component Composer inherits Rectangle {
    property <int> emoji-request: ChatData.emoji-request;
    changed emoji-request => {
        emoji-popup.show();
    }
    property <int> gif-request: ChatData.gif-request;
    changed gif-request => {
        gif-popup.show();
    }
    property <int> focus-request: ChatData.focus-request;
    // Hauteur du texte saisi, mesurée par un Text invisible (la zone grandit jusqu'à 6 lignes).
    property <length> composer-height: Math.clamp(measure.preferred-height + 20px, 40px, 150px);
    preferred-height: layout.preferred-height;
    min-height: layout.min-height;

    changed focus-request => {
        input.focus();
    }

    layout := HorizontalLayout {
        spacing: 4px;

        VerticalLayout {
            alignment: end;
            padding-bottom: 3px;
            IconButton {
                icon: @image-url("icons/attach.svg");
                clicked => {
                    ChatData.attach();
                }
            }
        }

        keys := FocusScope {
            horizontal-stretch: 1;
            height: root.composer-height;
            focus-on-click: false;
            capture-key-pressed(event) => {
                if event.text == Key.Return && !event.modifiers.shift {
                    ChatData.send();
                    return accept;
                }
                if event.text == Key.Escape {
                    if ChatData.cancel-banner() {
                        return accept;
                    }
                    return reject;
                }
                if event.text == Key.UpArrow && ChatData.draft == "" {
                    if ChatData.edit-last() {
                        return accept;
                    }
                    return reject;
                }
                if (event.modifiers.control || event.modifiers.meta) && (event.text == "v" || event.text == "V") {
                    if ChatData.paste-media() {
                        return accept;
                    }
                }
                return reject;
            }

            input := TextEdit {
                width: parent.width;
                height: parent.height;
                text <=> ChatData.draft;
                wrap: word-wrap;
                font-size: 14px;
                placeholder-text: "Message à " + ChatData.title;
                edited(text) => {
                    ChatData.typing-changed();
                }
            }
        }

        VerticalLayout {
            alignment: end;
            padding-bottom: 3px;
            HorizontalLayout {
                spacing: 2px;
                emoji-button := IconButton {
                    icon: @image-url("icons/emoji.svg");
                    active: emoji-popup.is-open;
                    clicked => {
                        emoji-popup.show();
                    }
                }
                // GIF de GIPHY.
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 6px;
                    background: gif-touch.has-hover || gif-popup.is-open ? Theme.nav-hover : transparent;
                    Rectangle {
                        width: 24px;
                        height: 16px;
                        border-radius: 3px;
                        border-width: 1.6px;
                        border-color: gif-touch.has-hover || gif-popup.is-open ? Theme.text : Theme.subtle;
                        Text {
                            text: "GIF";
                            color: gif-touch.has-hover || gif-popup.is-open ? Theme.text : Theme.subtle;
                            font-size: 8.5px;
                            font-weight: 800;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    gif-touch := TouchArea {
                        clicked => {
                            gif-popup.show();
                            if ChatData.gifs.length == 0 {
                                ChatData.gif-search();
                            }
                        }
                    }
                }
                IconButton {
                    icon: @image-url("icons/sticker.svg");
                    active: sticker-popup.is-open;
                    clicked => {
                        sticker-popup.show();
                    }
                }
                IconButton {
                    icon: @image-url("icons/send.svg");
                    tint: Theme.accent;
                    enabled: ChatData.draft != "" || ChatData.pending.length > 0;
                    clicked => {
                        ChatData.send();
                        input.focus();
                    }
                }
            }
        }
    }

    // Mesure invisible de la hauteur du texte saisi.
    measure := Text {
        x: -10000px;
        width: Math.max(100px, keys.width - 28px);
        text: ChatData.draft + " ";
        font-size: 14px;
        wrap: word-wrap;
        opacity: 0;
    }

    // ------------------------------------------------ fenêtres surgissantes
    emoji-popup := PopupWindow {
        x: root.width - self.width;
        y: -self.height - 8px;
        width: 9 * 40px + 34px;
        height: 460px;
        close-policy: close-on-click-outside;
        EmojiPicker {
            picked(cell) => {
                ChatData.emoji-picked(cell, false);
            }
        }
    }

    gif-popup := PopupWindow {
        x: root.width - self.width;
        y: -self.height - 8px;
        width: 420px;
        height: 460px;
        close-policy: close-on-click-outside;
        GifPicker {
            sent => {
                gif-popup.close();
            }
        }
    }

    sticker-popup := PopupWindow {
        x: root.width - self.width;
        y: -self.height - 8px;
        width: 4 * 84px + 24px;
        height: 380px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.popup;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.card-border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Autocollants et GIF";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Créer…";
                        clicked => {
                            ChatData.add-sticker();
                        }
                    }
                }
                if ChatData.stickers.length == 0: Text {
                    text: "Aucun autocollant pour l'instant. « Créer… » transforme une image en autocollant, ou ajoute un GIF animé à votre bibliothèque.";
                    color: Theme.subtle;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                ScrollView {
                    vertical-stretch: 1;
                    Rectangle {
                        height: Math.ceil(ChatData.stickers.length / 4) * 84px;
                        for sticker[i] in ChatData.stickers: Rectangle {
                            x: Math.mod(i, 4) * 84px;
                            y: Math.floor(i / 4) * 84px;
                            width: 80px;
                            height: 80px;
                            border-radius: 8px;
                            background: cell.has-hover ? Theme.nav-hover : transparent;
                            cell := TouchArea {
                                clicked => {
                                    ChatData.send-sticker(sticker.id);
                                    sticker-popup.close();
                                }
                            }
                            AnimatedImage {
                                x: 6px;
                                y: 6px;
                                width: 68px;
                                height: 68px;
                                still: sticker.image;
                                frames: sticker.frames;
                                frame-ms: sticker.frame-ms;
                            }
                            if cell.has-hover: Rectangle {
                                x: parent.width - 24px;
                                y: 2px;
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.popup;
                                border-width: 1px;
                                border-color: Theme.card-border;
                                Image {
                                    source: @image-url("icons/close.svg");
                                    colorize: Theme.subtle;
                                    width: 12px;
                                    height: 12px;
                                    x: 5px;
                                    y: 5px;
                                }
                                TouchArea {
                                    clicked => {
                                        ChatData.remove-sticker(sticker.id);
                                    }
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "Clic : envoyer  ·  ✕ : retirer de la bibliothèque";
                    color: Theme.subtle;
                    font-size: 11px;
                }
            }
        }
    }
}

// Conversation affichée : en-tête, messages, zone de saisie et fenêtres surgissantes.
component ConversationPane inherits Rectangle {
    property <int> profile-request: ChatData.profile-request;
    changed profile-request => {
        profile-popup.show();
    }

    profile-popup := PopupWindow {
        x: (root.width - 300px) / 2;
        y: 64px;
        width: 300px;
        height: card.preferred-height;
        close-policy: close-on-click-outside;

        card := ProfileCard {
            profile: ChatData.profile;
            link-clicked(url) => {
                ChatData.open-link(url);
            }
            if ChatData.profile.can-chat || ChatData.profile.me: HorizontalLayout {
                alignment: start;
                padding-top: 6px;
                if ChatData.profile.can-chat: Button {
                    text: "Discuter";
                    primary: true;
                    clicked => {
                        profile-popup.close();
                        ChatData.open-direct(ChatData.profile.id);
                    }
                }
                if ChatData.profile.me: Button {
                    text: "Modifier mon profil";
                    clicked => {
                        profile-popup.close();
                        ChatData.edit-profile();
                    }
                }
            }
        }
    }

    property <bool> follow: true;
    property <int> scroll-request: ChatData.scroll-request;

    changed scroll-request => {
        root.follow = true;
        messages-view.content-y = Math.min(0px, messages-view.visible-height - messages-view.content-height);
    }

    VerticalLayout {

        // ---- en-tête
        Rectangle {
            height: 60px;
HorizontalLayout {
                padding-left: 18px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Avatar {
                        initials: ChatData.initials;
                        tint: ChatData.color;
                        photo: ChatData.photo;
                        has-photo: ChatData.has-photo;
                        size: 34px;
                        show-presence: !ChatData.is-group;
                        online: ChatData.online;
                        presence: ChatData.presence;
                        ring: Theme.chat-bg;
                        TouchArea {
                            enabled: !ChatData.is-group;
                            mouse-cursor: ChatData.is-group ? MouseCursor.default : MouseCursor.pointer;
                            clicked => {
                                ChatData.show-profile(ChatData.peer-id);
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: ChatData.title;
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: ChatData.subtitle;
                        color: Theme.subtle;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/pin.svg");
                        active: pins-popup.is-open;
                        clicked => {
                            ChatData.prepare-pins();
                            pins-popup.show();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: CanvasData.open ? @image-url("icons/chat.svg") : @image-url("icons/canvas.svg");
                        active: CanvasData.open;
                        clicked => {
                            CanvasData.toggle();
                        }
                    }
                }
                if ChatData.is-group: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("icons/people.svg");
                        clicked => {
                            group-popup.show();
                        }
                    }
                }
            }
        
        }

        Divider { }

        // ---- messages
        messages-view := ScrollView {
            vertical-stretch: 1;
            changed content-height => {
                if root.follow {
                    self.content-y = Math.min(0px, self.visible-height - self.content-height);
                }
            }
            changed visible-height => {
                if root.follow {
                    self.content-y = Math.min(0px, self.visible-height - self.content-height);
                }
            }
            scrolled => {
                root.follow = self.content-y <= self.visible-height - self.content-height + 48px;
            }

            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 14px;
                alignment: start;

                if ChatData.history-start: VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 18px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: start;
                        Avatar {
                            initials: ChatData.initials;
                            tint: ChatData.color;
                            photo: ChatData.photo;
                            has-photo: ChatData.has-photo;
                            size: 64px;
                        }
                    }
                    Text {
                        text: ChatData.is-group ? "Bienvenue dans « " + ChatData.title + " »" : "Début de votre discussion avec " + ChatData.title;
                        color: Theme.text;
                        font-size: 22px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Messages chiffrés de bout en bout, directement entre vos appareils : aucun serveur, aucun Internet.";
                        color: Theme.subtle;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                for message[i] in ChatData.messages: VerticalLayout {
                    if message.system: SystemRow {
                        message: message;
                    }
                    if !message.system: MessageRow {
                        message: message;
                        index: i;
                        can-act: !ChatData.closed;
                        bubble-max: Math.min(560px, messages-view.visible-width - 140px);
                    }
                }
            }
        }

        // ---- saisie
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 4px;
            spacing: 6px;

            if ChatData.banner != "": Rectangle {
                height: 34px;
                border-radius: 8px;
                background: Theme.bubble;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 8px;
                    Text {
                        text: ChatData.banner;
                        color: Theme.subtle;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/close.svg");
                            size: 26px;
                            clicked => {
                                if ChatData.cancel-banner() {
                                    ChatData.focus-request += 1;
                                }
                            }
                        }
                    }
                }
            }

            if ChatData.pending.length > 0: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for name[i] in ChatData.pending: PendingChip {
                    name: name;
                    remove => {
                        ChatData.remove-pending(i);
                    }
                }
                if ChatData.pending-more > 0: Text {
                    text: "+ " + ChatData.pending-more + " autre(s)";
                    color: Theme.subtle;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            if ChatData.closed: Rectangle {
                height: 44px;
                border-radius: 8px;
                background: Theme.bubble;
                Text {
                    text: "Vous avez quitté ce groupe : l'historique reste consultable ici, en lecture seule.";
                    color: Theme.subtle;
                    font-size: 13px;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if !ChatData.closed: Composer { }

            Text {
                height: 16px;
                text: ChatData.typing;
                color: Theme.subtle;
                font-size: 11px;
                font-italic: true;
                overflow: elide;
            }
        }
    }

    // Canevas : par-dessus les messages et la zone de saisie (sous l'en-tête).
    if CanvasData.open: CanvasPane {
        x: 0px;
        y: 61px;
        width: parent.width;
        height: parent.height - 61px;
    }

    // ------------------------------------------------ menus stylisés
    property <int> actions-request: ChatData.actions-request;
    property <length> menu-x: Math.max(8px, Math.min(ChatData.actions-x - root.absolute-position.x, root.width - 268px));
    property <length> menu-y: ChatData.actions-y - root.absolute-position.y;
    changed actions-request => {
        actions-popup.show();
    }

    actions-popup := PopupWindow {
        x: root.menu-x;
        y: Math.max(8px, Math.min(root.menu-y, root.height - self.height - 8px));
        width: 260px;
        height: actions-col.preferred-height + 2px;
        close-policy: close-on-click-outside;
        MenuPanel {
            actions-col := VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if !ChatData.closed: HorizontalLayout {
                    spacing: 2px;
                    for emoji in ["👍", "❤️", "😂", "😮", "😢", "🎉"]: EmojiButton {
                        emoji: emoji;
                        size: 32px;
                        clicked => {
                            actions-popup.close();
                            ChatData.toggle-reaction(ChatData.actions-index, emoji);
                        }
                    }
                    EmojiButton {
                        emoji: "➕";
                        size: 32px;
                        clicked => {
                            actions-popup.close();
                            reaction-popup.show();
                        }
                    }
                }
                if !ChatData.closed: MenuLine { }
                if !ChatData.closed: MenuRow {
                    icon: @image-url("icons/reply.svg");
                    text: "Répondre";
                    clicked => {
                        actions-popup.close();
                        ChatData.message-action(ChatData.actions-index, "reply");
                    }
                }
                if !ChatData.closed: MenuRow {
                    icon: @image-url("icons/forward.svg");
                    text: "Transférer…";
                    clicked => {
                        actions-popup.close();
                        ChatData.prepare-forward();
                        forward-popup.show();
                    }
                }
                if !ChatData.closed: MenuRow {
                    icon: @image-url("icons/pin.svg");
                    text: ChatData.actions-message.pinned-by == "" ? "Épingler" : "Désépingler";
                    clicked => {
                        actions-popup.close();
                        ChatData.message-action(ChatData.actions-index, ChatData.actions-message.pinned-by == "" ? "pin" : "unpin");
                    }
                }
                if ChatData.actions-message.has-text: MenuRow {
                    icon: @image-url("icons/copy.svg");
                    text: "Copier le texte";
                    clicked => {
                        actions-popup.close();
                        ChatData.message-action(ChatData.actions-index, "copy");
                    }
                }
                if ChatData.actions-message.has-code: MenuRow {
                    icon: @image-url("icons/code.svg");
                    text: "Copier le code";
                    clicked => {
                        actions-popup.close();
                        ChatData.message-action(ChatData.actions-index, "copy-code");
                    }
                }
                if ChatData.actions-message.mine && !ChatData.closed: MenuLine { }
                if ChatData.actions-message.mine && ChatData.actions-message.has-text && !ChatData.closed: MenuRow {
                    icon: @image-url("icons/edit.svg");
                    text: "Modifier";
                    clicked => {
                        actions-popup.close();
                        ChatData.message-action(ChatData.actions-index, "edit");
                    }
                }
                if ChatData.actions-message.mine && !ChatData.closed: MenuRow {
                    icon: @image-url("icons/delete.svg");
                    text: "Supprimer pour tout le monde";
                    danger: true;
                    clicked => {
                        actions-popup.close();
                        ChatData.message-action(ChatData.actions-index, "delete");
                    }
                }
            }
        }
    }

    reaction-popup := PopupWindow {
        x: Math.max(8px, Math.min(ChatData.actions-x - root.absolute-position.x, root.width - self.width - 8px));
        y: Math.max(8px, Math.min(root.menu-y, root.height - self.height - 8px));
        width: 9 * 40px + 34px;
        height: 460px;
        close-policy: close-on-click-outside;
        EmojiPicker {
            picked(cell) => {
                reaction-popup.close();
                ChatData.emoji-picked(cell, true);
            }
        }
    }

    forward-popup := PopupWindow {
        x: root.menu-x;
        y: Math.max(8px, Math.min(root.menu-y, root.height - self.height - 8px));
        width: 260px;
        height: forward-col.preferred-height + 2px;
        close-policy: close-on-click-outside;
        MenuPanel {
            forward-col := VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuTitle {
                    text: "TRANSFÉRER VERS";
                }
                if ChatData.forward-choices.length == 0: Text {
                    text: "Aucune autre discussion : créez-en une avec +.";
                    color: Theme.subtle;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                for choice in ChatData.forward-choices: MenuRow {
                    icon: @image-url("icons/chat.svg");
                    text: choice.name;
                    clicked => {
                        forward-popup.close();
                        ChatData.forward(ChatData.actions-index, choice.id);
                    }
                }
            }
        }
    }

    pins-popup := PopupWindow {
        x: root.width - 340px;
        y: 58px;
        width: 330px;
        height: Math.min(pins-col.preferred-height + 2px, root.height - 80px);
        close-policy: close-on-click-outside;
        MenuPanel {
            pins-col := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                MenuTitle {
                    text: "MESSAGES ÉPINGLÉS (" + ChatData.pins.length + ")";
                }
                if ChatData.pins.length == 0: Text {
                    text: "Aucun pour l'instant : « Épingler » dans le menu d'un message (clic droit ou ⋯).";
                    color: Theme.subtle;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                for pin in ChatData.pins: Rectangle {
                    height: 50px;
                    border-radius: 6px;
                    background: Theme.bubble.with-alpha(0.6);
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: pin.author + " · " + pin.time;
                                color: Theme.subtle;
                                font-size: 11px;
                                overflow: elide;
                            }
                            Text {
                                text: pin.text;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/close.svg");
                                size: 28px;
                                clicked => {
                                    ChatData.unpin(pin.id);
                                    ChatData.prepare-pins();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    group-popup := PopupWindow {
        x: root.width - 280px;
        y: 56px;
        width: 270px;
        height: group-col.preferred-height + 2px;
        close-policy: close-on-click-outside;
        MenuPanel {
            group-col := VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if !ChatData.closed: MenuRow {
                    icon: @image-url("icons/person-add.svg");
                    text: "Ajouter des membres…";
                    clicked => {
                        group-popup.close();
                        ChatData.add-members();
                    }
                }
                if ChatData.is-creator && !ChatData.closed: MenuRow {
                    icon: @image-url("icons/edit.svg");
                    text: "Renommer le groupe…";
                    clicked => {
                        group-popup.close();
                        ChatData.rename();
                    }
                }
                if !ChatData.closed: MenuLine { }
                MenuTitle {
                    text: "MEMBRES (" + ChatData.members.length + ")";
                }
                for member in ChatData.members: VerticalLayout {
                    spacing: 1px;
                    MenuRow {
                        icon: @image-url("icons/people.svg");
                        text: member.name + " — " + member.state;
                        enabled: false;
                    }
                    if member.friend == 0 && !ChatData.closed: MenuRow {
                        icon: @image-url("icons/person-add.svg");
                        text: "      Ajouter en ami";
                        clicked => {
                            group-popup.close();
                            ChatData.friend-request(member.id);
                        }
                    }
                    if member.friend == 4: MenuRow {
                        icon: @image-url("icons/person-add.svg");
                        text: "      Accepter sa demande d'ami";
                        clicked => {
                            group-popup.close();
                            ChatData.friend-accept(member.id);
                        }
                    }
                }
                if !ChatData.closed: MenuLine { }
                if !ChatData.closed: MenuRow {
                    icon: @image-url("icons/leave.svg");
                    text: "Quitter le groupe";
                    danger: true;
                    clicked => {
                        group-popup.close();
                        ChatData.leave();
                    }
                }
            }
        }
    }
}



export component ChatPage inherits Rectangle {
    background: Theme.chat-bg;

    HorizontalLayout {
        // ------------------------------------------------ liste des conversations
        Rectangle {
            width: 280px;
            background: Theme.list-bg;

            VerticalLayout {
                Rectangle {
                    height: 60px;
HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: "Discussions";
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            new-button := IconButton {
                                icon: @image-url("icons/plus.svg");
                                clicked => {
                                    new-popup.show();
                                }
                            }
                        }
                    }
                
                }

                Divider { }

                if ChatData.conversations.length == 0: VerticalLayout {
                    padding: 18px;
                    spacing: 6px;
                    Text {
                        text: "Aucune discussion";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    Text {
                        text: "Cliquez sur + pour écrire à un appareil associé ou créer un groupe.";
                        color: Theme.subtle;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;
                        for conversation[i] in ChatData.conversations: ConversationRow {
                            item: conversation;
                            clicked => {
                                ChatData.select(i);
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.card-border;
            }
        }

        // ------------------------------------------------ conversation
        if !ChatData.has-conversation: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding: 40px;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    background: Theme.bubble;
                    Image {
                        source: @image-url("icons/chat.svg");
                        colorize: Theme.accent;
                        width: 36px;
                        height: 36px;
                        x: 18px;
                        y: 18px;
                    }
                }
            }
            Text {
                text: "Vos discussions restent sur votre réseau";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Messages chiffrés de bout en bout, sans serveur ni Internet. Associez un appareil dans la page Appareils, puis cliquez sur + pour lui écrire ou créer un groupe.";
                color: Theme.subtle;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if ChatData.has-conversation: ConversationPane {
            horizontal-stretch: 1;
        }
    }


    new-popup := PopupWindow {
        x: 20px;
        y: 56px;
        width: 260px;
        height: new-col.preferred-height + 2px;
        close-policy: close-on-click-outside;
        MenuPanel {
            new-col := VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuRow {
                    icon: @image-url("icons/people.svg");
                    text: "Nouveau groupe…";
                    clicked => {
                        new-popup.close();
                        ChatData.new-group();
                    }
                }
                MenuLine { }
                MenuTitle {
                    text: "DISCUTER AVEC";
                }
                if ChatData.direct-choices.length == 0: Text {
                    text: "Associez d'abord un appareil (page Appareils).";
                    color: Theme.subtle;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                for choice in ChatData.direct-choices: MenuRow {
                    icon: @image-url("icons/chat.svg");
                    text: choice.name;
                    clicked => {
                        new-popup.close();
                        ChatData.open-direct(choice.id);
                    }
                }
            }
        }
    }
}

// ------------------------------------------------------------------ boîte de dialogue

export component ChatDialog inherits Rectangle {
    background: #00000099;

    TouchArea { }

    Rectangle {
        width: Math.min(460px, parent.width - 48px);
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.dark ? #2d2d2d : #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;

        content := VerticalLayout {
            padding: 22px;
            spacing: 12px;

            Text {
                text: ChatData.dialog-title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if ChatData.dialog-text != "": Text {
                text: ChatData.dialog-text;
                color: Theme.subtle;
                font-size: 13px;
                wrap: word-wrap;
            }
            if ChatData.dialog == 1 || ChatData.dialog == 3: LineEdit {
                text <=> ChatData.dialog-name;
                placeholder-text: "Nom du groupe";
                accepted => {
                    ChatData.dialog-accepted();
                }
            }
            if ChatData.dialog == 1 || ChatData.dialog == 2: VerticalLayout {
                spacing: 2px;
                for choice[i] in ChatData.choices: CheckBox {
                    text: choice.name;
                    checked: choice.checked;
                    toggled => {
                        ChatData.toggle-choice(i, self.checked);
                    }
                }
            }
            if ChatData.dialog-error != "": Text {
                text: ChatData.dialog-error;
                color: Theme.danger;
                font-size: 13px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Annuler";
                    clicked => {
                        ChatData.dialog = 0;
                    }
                }
                Button {
                    text: ChatData.dialog == 1 ? "Créer le groupe" : ChatData.dialog == 2 ? "Ajouter" : ChatData.dialog == 3 ? "Renommer" : ChatData.dialog == 4 ? "Supprimer" : "Quitter le groupe";
                    primary: true;
                    clicked => {
                        ChatData.dialog-accepted();
                    }
                }
            }
        }
    }
}
