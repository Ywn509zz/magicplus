// Interface MagicPlus, dans l'esprit de Windows 11 (Fluent) :
// navigation à gauche, fond « Mica », cartes arrondies, thème clair ou sombre.

import { Button, Switch, LineEdit, ComboBox, CheckBox, ProgressIndicator, ScrollView, TextEdit, Palette, Slider } from "std-widgets.slint";
import { Theme, Anim, ThemeColors, ThemeChoice } from "theme.slint";
import { ChatPage, ChatDialog, ChatData, ConversationItem, MessageItem, AttachmentItem, ReactionItem, ChoiceItem, StickerItem, MemberItem, MentionItem, PinItem, EmojiCell, EmojiRow, InlinePiece, GifItem } from "chat.slint";

import { MarkdownStyle, BlockItem, TableRowItem, TableCellItem, MarkdownView } from "markdown.slint";
import { ProfileCard, ProfileItem, Avatar, PresenceDot, FullProfileView, FullProfileItem, GroupLink } from "profile.slint";
import { CanvasData, CanvasItem, VersionItem, FormatButton, FormatResult } from "canvas.slint";
import { ImageViewer, ViewerItem } from "viewer.slint";

export { ChatData, ConversationItem, MessageItem, AttachmentItem, ReactionItem, ChoiceItem, StickerItem, MemberItem, MentionItem, PinItem, EmojiCell, EmojiRow, InlinePiece, GifItem }
export { MarkdownStyle, BlockItem, TableRowItem, TableCellItem, ProfileItem, FullProfileItem, GroupLink, ViewerItem }
export { CanvasData, CanvasItem, VersionItem, FormatButton, FormatResult }
export { Anim, Theme, ThemeColors, ThemeChoice }

export struct PeerItem {
    id: string,
    // Nom affiché : notre surnom, sinon son pseudo, sinon le nom de l'appareil.
    name: string,
    device-name: string,
    alias: string,
    pseudo: string,
    platform: string,
    address: string,
    fingerprint: string,
    trusted: bool,
    online: bool,
    key-changed: bool,
    wants-pairing: bool,
}

export struct FriendRequestItem {
    id: string,
    title: string,
    detail: string,
    // Reçue (Accepter / Refuser) ; sinon envoyée (Annuler).
    incoming: bool,
}

export struct TransferItem {
    id: string,
    file-name: string,
    details: string,
    progress: float,
    // 0 = en cours, 1 = terminé, 2 = échoué, 3 = en pause (reprise automatique)
    state: int,
    error: string,
    sending: bool,
}

export struct ReceivedItem {
    id: string,
    file-name: string,
    details: string,
    saved: bool,
    path: string,
}

export struct ManualItem {
    address: string,
    status: string,
    // 0 = pas de réponse, 1 = MagicPlus trouvé, 2 = adresse introuvable
    state: int,
}

component Card inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    border-radius: 8px;
    preferred-height: inner.preferred-height;
    min-height: inner.min-height;

    inner := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        @children
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 14px;
    font-weight: 600;
}

component Subtle inherits Text {
    color: Theme.subtle;
    font-size: 12px;
    wrap: word-wrap;
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    height: 22px;
    border-radius: 11px;
    background: root.tint.with-alpha(0.16);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.45);
    min-width: label.preferred-width + 22px;
    preferred-width: label.preferred-width + 22px;

    label := Text {
        text: root.text;
        color: root.tint;
        font-size: 12px;
        font-weight: 600;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component IconBubble inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.accent;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: Theme.bubble;

    Image {
        source: root.icon;
        colorize: root.tint;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <int> badge;
    callback clicked;
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Theme.accent;
        visible: root.selected;
    }

    Image {
        source: root.icon;
        colorize: root.selected ? Theme.accent : Theme.text;
        width: 18px;
        height: 18px;
        x: 14px;
        y: (parent.height - self.height) / 2;
    }

    if root.badge > 0: Rectangle {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        height: 20px;
        width: Math.max(20px, count.preferred-width + 12px);
        border-radius: 10px;
        background: Theme.badge;
        count := Text {
            text: root.badge > 99 ? "99+" : root.badge;
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 46px;
        width: parent.width - 52px - (root.badge > 0 ? 36px : 0px);
        height: parent.height;
        text: root.label;
        color: Theme.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component PeerCard inherits Card {
    in property <PeerItem> peer;
    callback pair(PeerItem);
    callback forget(string);
    callback chat(string);
    callback alias(PeerItem);
    callback profile(string);

    HorizontalLayout {
        spacing: 14px;

        IconBubble {
            icon: @image-url("icons/laptop.svg");
            tint: root.peer.online ? Theme.accent : Theme.neutral;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.peer.name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: (root.peer.device-name != root.peer.name ? root.peer.device-name + "  ·  " : "") + root.peer.platform + (root.peer.address != "" ? "  ·  " + root.peer.address : "") + (root.peer.alias != "" && root.peer.pseudo != "" ? "  ·  pseudo « " + root.peer.pseudo + " »" : "");
                color: Theme.subtle;
                font-size: 12px;
                overflow: elide;
            }
            Text {
                text: "Empreinte  " + root.peer.fingerprint;
                color: Theme.subtle;
                font-size: 12px;
                overflow: elide;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Pill {
                text: root.peer.key-changed ? "Clé modifiée" : root.peer.trusted ? (root.peer.online ? "Associé · en ligne" : "Associé · hors ligne") : root.peer.wants-pairing ? "Demande d'association" : root.peer.online ? "Détecté" : "Détecté · hors ligne";
                tint: root.peer.key-changed ? Theme.danger : root.peer.trusted ? (root.peer.online ? Theme.success : Theme.neutral) : root.peer.wants-pairing ? Theme.warning : root.peer.online ? Theme.accent : Theme.neutral;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            if root.peer.trusted: HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Profil";
                    clicked => {
                        root.profile(root.peer.id);
                    }
                }
                Button {
                    text: "Surnom…";
                    clicked => {
                        root.alias(root.peer);
                    }
                }
                Button {
                    text: "Discuter";
                    clicked => {
                        root.chat(root.peer.id);
                    }
                }
                Button {
                    text: "Oublier";
                    clicked => {
                        root.forget(root.peer.id);
                    }
                }
            }
            if !root.peer.trusted: Button {
                text: root.peer.key-changed ? "Associer à nouveau" : "Associer";
                primary: !root.peer.key-changed;
                enabled: root.peer.online;
                clicked => {
                    root.pair(root.peer);
                }
            }
        }
    }
}

component TransferCard inherits Card {
    in property <TransferItem> item;
    callback cancel(string);

    HorizontalLayout {
        spacing: 14px;

        IconBubble {
            icon: root.item.sending ? @image-url("icons/upload.svg") : @image-url("icons/download.svg");
            tint: root.item.state == 2 ? Theme.danger : root.item.state == 1 ? Theme.success : root.item.state == 3 ? Theme.warning : Theme.accent;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text {
                text: root.item.file-name;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.state == 2 ? root.item.error : root.item.state == 3 ? root.item.details + "  ·  " + root.item.error : root.item.details;
                color: root.item.state == 2 ? Theme.danger : root.item.state == 3 ? Theme.warning : Theme.subtle;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.item.state == 0: ProgressIndicator {
                progress: root.item.progress;
            }
        }

        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Pill {
                text: root.item.state == 2 ? "Échec" : root.item.state == 1 ? "Terminé" : root.item.state == 3 ? "En pause · " + round(root.item.progress * 100) + " %" : round(root.item.progress * 100) + " %";
                tint: root.item.state == 2 ? Theme.danger : root.item.state == 1 ? Theme.success : root.item.state == 3 ? Theme.warning : Theme.accent;
            }
        }

        if root.item.state == 0 || root.item.state == 3: VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Button {
                text: "Annuler";
                clicked => {
                    root.cancel(root.item.id);
                }
            }
        }
    }
}

// Ligne du menu des statuts : pastille, nom, explication. La zone cliquable est posée
// par-dessus le contenu (comme les menus des discussions).
component PresenceRow inherits Rectangle {
    in property <int> presence;
    in property <string> title;
    in property <string> detail;
    callback clicked;
    min-height: row.min-height;
    preferred-height: Math.max(36px, row.preferred-height);
    border-radius: 6px;
    background: touch.has-hover ? Theme.nav-hover : transparent;

    row := HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            PresenceDot {
                size: 14px;
                presence: root.presence;
                ring: Theme.popup;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.subtle;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Pastille d'aperçu d'un thème : son fond, un panneau, un trait d'accent et son nom.
component ThemeSwatch inherits Rectangle {
    in property <ThemeChoice> choice;
    callback picked();
    width: 104px;
    height: 84px;

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.picked();
        }
    }

    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 58px;
            border-radius: 8px;
            background: root.choice.background;
            border-width: root.choice.selected ? 2px : 1px;
            border-color: root.choice.selected ? Theme.accent : touch.has-hover ? Theme.subtle : Theme.card-border;
            clip: true;
            Rectangle {
                x: 0px;
                width: 26px;
                height: parent.height;
                background: root.choice.panel;
            }
            Rectangle {
                x: 34px;
                y: 14px;
                width: 52px;
                height: 6px;
                border-radius: 3px;
                background: root.choice.text.with-alpha(0.7);
            }
            Rectangle {
                x: 34px;
                y: 26px;
                width: 36px;
                height: 6px;
                border-radius: 3px;
                background: root.choice.text.with-alpha(0.35);
            }
            Rectangle {
                x: 34px;
                y: 40px;
                width: 22px;
                height: 8px;
                border-radius: 4px;
                background: root.choice.accent;
            }
        }
        Text {
            text: root.choice.name;
            color: root.choice.selected ? Theme.accent : Theme.text;
            font-size: 12px;
            font-weight: root.choice.selected ? 600 : 400;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Grille de pastilles qui passe à la ligne selon la largeur disponible.
component ThemePicker inherits Rectangle {
    in property <[ThemeChoice]> themes;
    callback picked(string);
    property <length> cell-w: 104px + 12px;
    property <length> cell-h: 84px + 12px;
    property <int> columns: Math.max(1, Math.floor((self.width + 12px) / root.cell-w));
    preferred-height: Math.ceil(root.themes.length / root.columns) * root.cell-h;
    min-height: self.preferred-height;

    for choice[i] in root.themes: ThemeSwatch {
        x: Math.mod(i, root.columns) * root.cell-w;
        y: Math.floor(i / root.columns) * root.cell-h;
        choice: choice;
        picked => {
            root.picked(choice.id);
        }
    }
}

export component AppWindow inherits Window {
    title: "MagicPlus";
    icon: @image-url("icons/shield.svg");
    preferred-width: 1040px;
    preferred-height: 700px;
    min-width: 660px;
    min-height: 460px;
    background: Theme.mica;
    default-font-size: 14px;

    // ---- données (remplies par Rust)
    in property <[PeerItem]> peers;
    in property <[TransferItem]> transfers;
    in property <[ReceivedItem]> received;
    in property <string> device-name;
    in property <string> device-platform;
    in property <string> device-fingerprint;
    in property <string> status;
    in property <bool> has-clip;
    in property <string> clip-from;
    in property <string> clip-text;
    in property <string> save-folder;
    in property <string> receive-folder;
    in property <string> hotkey-send;
    in property <string> hotkey-paste;
    in property <int> joinable-count;
    in property <int> paired-count;
    in property <string> version;
    in property <[ManualItem]> manual;
    // Appareils d'une autre version de MagicPlus (ils s'ignorent mutuellement) : explications.
    in property <[string]> version-warnings;
    // Mises à jour : description, bouton d'action (vide : caché), recherche en cours, page web.
    in property <string> update-text;
    in property <string> update-action;
    in property <bool> update-busy;
    in property <bool> update-has-page;
    in property <bool> update-pending;
    in-out property <bool> update-auto: true;
    // Choix des appareils qui reçoivent un fichier ou le presse-papiers.
    in-out property <bool> send-open;
    in property <string> send-title;
    in property <[ChoiceItem]> send-targets;
    // Recadrage d'une photo ou d'une bannière.
    in-out property <bool> crop-open;
    in property <bool> crop-banner;
    in property <image> crop-preview;
    in property <bool> crop-animated;
    in-out property <float> crop-zoom: 1;
    in-out property <float> crop-x: 0.5;
    in-out property <float> crop-y: 0.5;
    // Nouveautés (après une mise à jour, ou à la demande).
    in-out property <bool> news-open;
    in property <string> news-title;
    in property <[BlockItem]> news-blocks;
    // Démarrage avec la session, notifications du système.
    in-out property <bool> launch-at-login;
    in-out property <bool> notifications-on: true;
    // Mon profil (Paramètres).
    in property <ProfileItem> my-profile;
    // Ma présence (0 hors ligne/invisible, 1 en ligne, 2 inactif, 3 ne pas déranger) et son nom.
    in property <int> my-presence: 1;
    in property <string> my-presence-label: "En ligne";
    // 0 en ligne, 1 inactif, 2 ne pas déranger, 3 invisible.
    callback presence-picked(int);
    // Ouvre le menu des statuts (captures d'écran de développement).
    in property <int> presence-request;
    changed presence-request => {
        presence-popup.show();
    }
    // Notifications et inactivité automatique (Paramètres).
    in-out property <bool> notif-direct: true;
    // 0 tous les messages, 1 mentions seulement, 2 jamais.
    in-out property <int> notif-groups;
    in-out property <bool> notif-preview: true;
    in-out property <bool> notif-sound: true;
    in-out property <bool> notif-when-focused;
    // 0 jamais, 1 : 5 min, 2 : 10 min, 3 : 15 min, 4 : 30 min.
    in-out property <int> auto-idle-index: 2;
    callback notif-changed();
    callback notif-test();
    in-out property <string> profile-bio;
    in-out property <string> profile-pronouns;
    // -1 : couleur automatique, sinon index dans `banner-colors`.
    in-out property <int> profile-color-index: -1;
    out property <[color]> banner-colors: [#e5484d, #f76b15, #e2a300, #30a46c, #12a5b5, #3e7bfa, #8e4ec6, #d6409f, #a0714f, #8b8d98];
    in property <string> own-addresses;
    // Demandes d'ami (membres d'un groupe commun).
    in property <[FriendRequestItem]> friend-requests;
    // Pare-feu de Windows : 0 rien à faire, 2 bloque MagicPlus, 3 réglage en cours, 4 échec.
    in property <int> firewall-state;
    in property <string> firewall-error;

    // ---- état de l'interface
    in-out property <int> page: 0;
    in-out property <string> local-text;
    in-out property <string> name-edit;
    in-out property <string> pseudo-edit;
    // Surnom d'un appareil (fenêtre « Surnom… »).
    in-out property <bool> alias-open;
    in-out property <PeerItem> alias-peer;
    in-out property <string> alias-edit;
    in-out property <string> address-edit;
    in-out property <int> resume-index: 4;
    in-out property <bool> auto-copy: true;
    in-out property <bool> pairing-open: false;
    in-out property <PeerItem> pairing-peer;

    // ---- actions (traitées par Rust)
    callback trust(string);
    callback forget(string);
    callback send-clipboard();
    callback paste-received();
    callback read-clipboard() -> string;
    callback copy-text(string);
    callback send-files();
    callback choose-folder();
    callback clear-folder();
    callback save-name(string);
    callback resume-changed(int);
    callback auto-copy-changed(bool);
    callback cancel-transfer(string);
    callback open-path(string);
    callback remove-received(string);
    // Thèmes de couleur proposés (src/themes.rs) et choix de l'un d'eux.
    in property <[ThemeChoice]> themes;
    callback theme-picked(string);
    callback add-address(string);
    callback remove-address(string);
    callback chat-with(string);
    callback save-pseudo(string);
    callback set-alias(string, string);
    callback update-auto-changed(bool);
    callback launch-at-login-changed(bool);
    callback crop-changed();
    callback send-toggle(int, bool);
    // Envoyer un fichier (image reçue…) aux appareils choisis.
    callback send-file(string);
    callback send-confirm();
    callback crop-apply();
    callback show-news();
    callback notifications-changed(bool);
    // Demande d'ami : 1 accepter, 0 refuser, -1 retirer la nôtre.
    callback friend-answer(string, int);
    callback allow-firewall();
    callback update-check();
    callback update-act();
    callback update-open-page();
    callback profile-choose-photo();
    callback profile-remove-photo();
    callback profile-choose-banner();
    callback profile-remove-banner();
    callback profile-save();

    public function apply-theme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Revient au thème clair ou sombre de Windows.
    public function follow-system-theme() {
        Palette.color-scheme = ColorScheme.unknown;
    }

    VerticalLayout {
        HorizontalLayout {
            // ------------------------------------------------ navigation
            Rectangle {
                width: 232px;
                background: Theme.nav;

                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;

                    HorizontalLayout {
                        height: 56px;
                        padding-left: 6px;
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            y: 12px;
                            border-radius: 8px;
                            background: Theme.accent;
                            Image {
                                source: @image-url("icons/shield.svg");
                                colorize: Theme.dark ? #000000 : #ffffff;
                                width: 20px;
                                height: 20px;
                                x: 6px;
                                y: 6px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "MagicPlus";
                                color: Theme.text;
                                font-size: 16px;
                                font-weight: 700;
                            }
                        }
                    }

                    NavItem {
                        icon: @image-url("icons/laptop.svg");
                        label: "Appareils";
                        selected: root.page == 0;
                        clicked => {
                            root.page = 0;
                        }
                    }
                    NavItem {
                        icon: @image-url("icons/chat.svg");
                        label: "Discussions";
                        selected: root.page == 4;
                        badge: ChatData.unread;
                        clicked => {
                            root.page = 4;
                        }
                    }
                    NavItem {
                        icon: @image-url("icons/clipboard.svg");
                        label: "Presse-papiers";
                        selected: root.page == 1;
                        clicked => {
                            root.page = 1;
                        }
                    }
                    NavItem {
                        icon: @image-url("icons/transfer.svg");
                        label: "Transferts";
                        selected: root.page == 2;
                        clicked => {
                            root.page = 2;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    NavItem {
                        icon: @image-url("icons/settings.svg");
                        label: "Paramètres";
                        badge: root.update-pending ? 1 : 0;
                        selected: root.page == 3;
                        clicked => {
                            root.page = 3;
                        }
                    }

                    // Moi : photo avec pastille de présence, nom, statut (clic : changer).
                    me-panel := Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: me-touch.has-hover || presence-popup.is-open ? Theme.nav-hover : transparent;
                        me-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                presence-popup.show();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Avatar {
                                    size: 34px;
                                    initials: root.my-profile.initials;
                                    tint: root.my-profile.color;
                                    photo: root.my-profile.photo;
                                    has-photo: root.my-profile.has-photo;
                                    show-presence: true;
                                    presence: root.my-presence;
                                    ring: Theme.nav;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.my-profile.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.my-presence-label;
                                    color: Theme.subtle;
                                    font-size: 11.5px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            presence-popup := PopupWindow {
                x: 12px;
                y: root.height - self.height - 92px;
                width: 260px;
                height: presence-col.preferred-height + 2px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.popup;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000040;
                    presence-col := VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        PresenceRow {
                            presence: 1;
                            title: "En ligne";
                            clicked => {
                                root.presence-picked(0);
                                presence-popup.close();
                            }
                        }
                        PresenceRow {
                            presence: 2;
                            title: "Inactif";
                            clicked => {
                                root.presence-picked(1);
                                presence-popup.close();
                            }
                        }
                        PresenceRow {
                            presence: 3;
                            title: "Ne pas déranger";
                            detail: "Aucune notification";
                            clicked => {
                                root.presence-picked(2);
                                presence-popup.close();
                            }
                        }
                        PresenceRow {
                            presence: 0;
                            title: "Invisible";
                            detail: "Vous apparaîtrez hors ligne ; les messages passent";
                            clicked => {
                                root.presence-picked(3);
                                presence-popup.close();
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------ contenu
            if root.page == 4: ChatPage {
                horizontal-stretch: 1;
            }

            if root.page != 4: ScrollView {
                horizontal-stretch: 1;

                HorizontalLayout {
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-top: 28px;
                    padding-bottom: 28px;
                    alignment: stretch;

                    VerticalLayout {
                        spacing: 12px;
                        max-width: 900px;
                        alignment: start;

                        // ======== Appareils
                        if root.page == 0: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Appareils";
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 600;
                            }
                            Subtle {
                                text: "Les appareils qui exécutent MagicPlus sur le même réseau Wi-Fi ou Ethernet apparaissent ici automatiquement, sans Internet.";
                            }

                            Card {
                                HorizontalLayout {
                                    spacing: 14px;
                                    IconBubble {
                                        icon: @image-url("icons/shield.svg");
                                        tint: Theme.success;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.device-name + "  (cet appareil)";
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.device-platform + "  ·  Empreinte  " + root.device-fingerprint;
                                            color: Theme.subtle;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            SectionTitle {
                                text: "À proximité (" + root.peers.length + ")";
                            }

                            for warning in root.version-warnings: Card {
                                HorizontalLayout {
                                    spacing: 14px;
                                    IconBubble {
                                        icon: @image-url("icons/warning.svg");
                                        tint: Theme.warning;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Autre version de MagicPlus";
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }
                                        Subtle {
                                            text: warning;
                                        }
                                    }
                                }
                            }

                            if root.firewall-state >= 2: Card {
                                HorizontalLayout {
                                    spacing: 14px;
                                    IconBubble {
                                        icon: @image-url("icons/warning.svg");
                                        tint: Theme.warning;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: "Le pare-feu de Windows bloque MagicPlus";
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }
                                        Subtle {
                                            text: root.firewall-state == 3 ? "Acceptez la fenêtre de Windows qui demande l'autorisation…" : root.firewall-state == 4 ? "Pas modifié : " + root.firewall-error + ". Réessayez, ou demandez à l'administrateur du PC." : "Ce PC voit peut-être les autres appareils, mais eux ne peuvent pas le joindre (réseau classé « Public »). Un clic l'autorise sur tous les réseaux ; Windows demandera votre accord.";
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Button {
                                            text: "Autoriser MagicPlus";
                                            primary: true;
                                            enabled: root.firewall-state != 3;
                                            clicked => {
                                                root.allow-firewall();
                                            }
                                        }
                                    }
                                }
                            }

                            for request in root.friend-requests: Card {
                                HorizontalLayout {
                                    spacing: 14px;
                                    IconBubble {
                                        icon: @image-url("icons/person-add.svg");
                                        tint: request.incoming ? Theme.warning : Theme.neutral;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: request.title;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Subtle {
                                            text: request.detail;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        if request.incoming: HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Refuser";
                                                clicked => {
                                                    root.friend-answer(request.id, 0);
                                                }
                                            }
                                            Button {
                                                text: "Accepter";
                                                primary: true;
                                                clicked => {
                                                    root.friend-answer(request.id, 1);
                                                }
                                            }
                                        }
                                        if !request.incoming: Button {
                                            text: "Annuler";
                                            clicked => {
                                                root.friend-answer(request.id, -1);
                                            }
                                        }
                                    }
                                }
                            }

                            if root.peers.length == 0: Card {
                                HorizontalLayout {
                                    spacing: 14px;
                                    IconBubble {
                                        icon: @image-url("icons/wifi.svg");
                                        tint: Theme.neutral;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: "Aucun appareil MagicPlus détecté";
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }
                                        Subtle {
                                            text: "Ouvrez MagicPlus sur l'autre machine, branchée au même réseau privé. Sous Windows, autorisez MagicPlus dans le pare-feu (réseaux privés et publics) quand Windows le demande.";
                                        }
                                    }
                                }
                            }

                            for peer in root.peers: PeerCard {
                                peer: peer;
                                pair(p) => {
                                    root.pairing-peer = p;
                                    root.pairing-open = true;
                                }
                                forget(id) => {
                                    root.forget(id);
                                }
                                chat(id) => {
                                    root.chat-with(id);
                                }
                                profile(id) => {
                                    ChatData.open-full-profile(id);
                                }
                                alias(p) => {
                                    root.alias-peer = p;
                                    root.alias-edit = p.alias;
                                    root.alias-open = true;
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Connexion par adresse IP";
                                }
                                Subtle {
                                    text: "Si l'autre appareil n'apparaît pas tout seul (réseau d'entreprise ou d'école, Wi-Fi invité, autre sous-réseau), saisissez son adresse IP : MagicPlus l'appellera directement. Il suffit de le faire sur une des deux machines, à condition que le pare-feu de chacune laisse passer MagicPlus.";
                                }
                                Text {
                                    text: root.own-addresses;
                                    color: Theme.text;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    LineEdit {
                                        text <=> root.address-edit;
                                        placeholder-text: "ex. 192.168.1.20";
                                        width: 260px;
                                        accepted(value) => {
                                            root.add-address(value);
                                        }
                                    }
                                    Button {
                                        text: "Ajouter";
                                        enabled: root.address-edit != "";
                                        clicked => {
                                            root.add-address(root.address-edit);
                                        }
                                    }
                                }
                                for item in root.manual: HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: item.address;
                                        color: Theme.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: item.status;
                                        color: item.state == 1 ? Theme.success : item.state == 2 ? Theme.warning : Theme.subtle;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Button {
                                        text: "Retirer";
                                        clicked => {
                                            root.remove-address(item.address);
                                        }
                                    }
                                }
                            }
                        }

                        // ======== Presse-papiers
                        if root.page == 1: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Presse-papiers";
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 600;
                            }
                            Subtle {
                                text: "Envoyez le texte copié vers vos appareils associés. Tout est chiffré de bout en bout.";
                            }

                            Card {
                                SectionTitle {
                                    text: "Envoyer";
                                }
                                Subtle {
                                    text: root.joinable-count == 0 ? "Aucun appareil associé n'est joignable pour le moment." : root.joinable-count + " appareil(s) associé(s) joignable(s)";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: "Envoyer le presse-papiers";
                                        primary: true;
                                        enabled: root.joinable-count > 0;
                                        clicked => {
                                            root.send-clipboard();
                                        }
                                    }
                                    Button {
                                        text: "Copier le dernier texte reçu";
                                        enabled: root.has-clip;
                                        clicked => {
                                            root.paste-received();
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Presse-papiers de cet appareil";
                                }
                                TextEdit {
                                    text <=> root.local-text;
                                    wrap: word-wrap;
                                    height: 110px;
                                    placeholder-text: "Cliquez sur « Lire le presse-papiers » pour afficher son contenu.";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: "Lire le presse-papiers";
                                        clicked => {
                                            root.local-text = root.read-clipboard();
                                        }
                                    }
                                    Button {
                                        text: "Copier ce texte";
                                        enabled: root.local-text != "";
                                        clicked => {
                                            root.copy-text(root.local-text);
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: root.has-clip ? "Dernier texte reçu de " + root.clip-from : "Dernier texte reçu";
                                }
                                if !root.has-clip: Subtle {
                                    text: "Rien reçu pour l'instant.";
                                }
                                if root.has-clip: TextEdit {
                                    text: root.clip-text;
                                    read-only: true;
                                    wrap: word-wrap;
                                    height: 110px;
                                }
                                if root.has-clip: HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: "Copier dans le presse-papiers";
                                        clicked => {
                                            root.copy-text(root.clip-text);
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Raccourcis globaux";
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        background: Theme.bubble;
                                        border-radius: 6px;
                                        preferred-height: 52px;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 2px;
                                            Text {
                                                text: "Copier et envoyer";
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: root.hotkey-send;
                                                color: Theme.subtle;
                                                font-size: 12px;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        background: Theme.bubble;
                                        border-radius: 6px;
                                        preferred-height: 52px;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 2px;
                                            Text {
                                                text: "Copier le dernier texte reçu";
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: root.hotkey-paste;
                                                color: Theme.subtle;
                                                font-size: 12px;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ======== Transferts
                        if root.page == 2: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Transferts";
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 600;
                            }
                            Subtle {
                                text: "Les fichiers passent directement d'un appareil à l'autre par le réseau local, chiffrés, avec vérification d'intégrité.";
                            }

                            Card {
                                SectionTitle {
                                    text: "Envoyer des fichiers";
                                }
                                Subtle {
                                    text: root.joinable-count == 0 ? "Aucun appareil associé n'est joignable pour le moment." : "Destination : " + root.joinable-count + " appareil(s) associé(s) joignable(s)";
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: "Choisir des fichiers…";
                                        primary: true;
                                        enabled: root.joinable-count > 0;
                                        clicked => {
                                            root.send-files();
                                        }
                                    }
                                }
                            }

                            SectionTitle {
                                text: "Récents";
                            }
                            if root.transfers.length == 0: Subtle {
                                text: "Aucun transfert pour l'instant.";
                            }
                            for item in root.transfers: TransferCard {
                                item: item;
                                cancel(id) => {
                                    root.cancel-transfer(id);
                                }
                            }

                            if root.received.length > 0: SectionTitle {
                                text: "Fichiers reçus";
                            }
                            for file in root.received: Card {
                                HorizontalLayout {
                                    spacing: 14px;
                                    IconBubble {
                                        icon: @image-url("icons/file.svg");
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: file.file-name;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: file.details;
                                            color: Theme.subtle;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Button {
                                                text: "Afficher";
                                                clicked => {
                                                    root.open-path(file.path);
                                                }
                                            }
                                            Button {
                                                text: "Retirer";
                                                clicked => {
                                                    root.remove-received(file.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ======== Paramètres
                        if root.page == 3: VerticalLayout {
                            spacing: 12px;
                            Text {
                                text: "Paramètres";
                                color: Theme.text;
                                font-size: 28px;
                                font-weight: 600;
                            }

                            Card {
                                SectionTitle {
                                    text: "Mon profil";
                                }
                                Subtle {
                                    text: "Comme sur Discord : vos contacts (appareils associés et membres de vos groupes) voient votre photo, votre bannière et votre présentation.";
                                }
                                HorizontalLayout {
                                    spacing: 20px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: start;
                                        ProfileCard {
                                            profile: root.my-profile;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Button {
                                                text: "Choisir une photo…";
                                                clicked => {
                                                    root.profile-choose-photo();
                                                }
                                            }
                                            Button {
                                                text: "Retirer";
                                                enabled: root.my-profile.has-photo;
                                                clicked => {
                                                    root.profile-remove-photo();
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Button {
                                                text: "Choisir une bannière…";
                                                clicked => {
                                                    root.profile-choose-banner();
                                                }
                                            }
                                            Button {
                                                text: "Retirer";
                                                enabled: root.my-profile.has-banner;
                                                clicked => {
                                                    root.profile-remove-banner();
                                                }
                                            }
                                        }
                                        Subtle {
                                            text: "PNG, JPEG ou GIF animé. La photo est recadrée en carré, la bannière en 5:2.";
                                        }
                                        Text {
                                            text: "Couleur de la bannière (sans image)";
                                            color: Theme.text;
                                            font-size: 13px;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 12px;
                                                background: Theme.bubble;
                                                border-width: root.profile-color-index == -1 ? 2px : 1px;
                                                border-color: root.profile-color-index == -1 ? Theme.text : Theme.card-border;
                                                Text {
                                                    text: "A";
                                                    color: Theme.subtle;
                                                    font-size: 11px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        root.profile-color-index = -1;
                                                    }
                                                }
                                            }
                                            for swatch[i] in root.banner-colors: Rectangle {
                                                width: 24px;
                                                height: 24px;
                                                border-radius: 12px;
                                                background: swatch;
                                                border-width: root.profile-color-index == i ? 2px : 0px;
                                                border-color: Theme.text;
                                                TouchArea {
                                                    clicked => {
                                                        root.profile-color-index = i;
                                                    }
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Pronoms";
                                            color: Theme.text;
                                            font-size: 13px;
                                        }
                                        LineEdit {
                                            text <=> root.profile-pronouns;
                                            placeholder-text: "ex. elle/elle, il/lui";
                                            width: 320px;
                                        }
                                        Text {
                                            text: "À propos de moi (Markdown, 190 caractères)";
                                            color: Theme.text;
                                            font-size: 13px;
                                        }
                                        TextEdit {
                                            text <=> root.profile-bio;
                                            wrap: word-wrap;
                                            width: 320px;
                                            height: 80px;
                                            placeholder-text: "Quelques mots sur vous… **gras**, *italique*, émojis 🙂";
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Enregistrer le profil";
                                                primary: true;
                                                clicked => {
                                                    root.profile-save();
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Apparence";
                                }
                                ThemePicker {
                                    themes: root.themes;
                                    picked(id) => {
                                        root.theme-picked(id);
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Statut et notifications";
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    Text {
                                        text: "Passer en « Inactif » sans clavier ni souris pendant :";
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        width: 140px;
                                        model: ["Jamais", "5 minutes", "10 minutes", "15 minutes", "30 minutes"];
                                        current-index <=> root.auto-idle-index;
                                        selected => {
                                            root.notif-changed();
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    padding-left: 12px;
                                    CheckBox {
                                        text: "Discussions à deux";
                                        enabled: root.notifications-on;
                                        checked <=> root.notif-direct;
                                        toggled => {
                                            root.notif-changed();
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        Text {
                                            text: "Groupes :";
                                            color: root.notifications-on ? Theme.text : Theme.subtle;
                                            vertical-alignment: center;
                                        }
                                        ComboBox {
                                            width: 220px;
                                            enabled: root.notifications-on;
                                            model: ["Tous les messages", "Seulement si on me mentionne (@)", "Jamais"];
                                            current-index <=> root.notif-groups;
                                            selected => {
                                                root.notif-changed();
                                            }
                                        }
                                    }
                                    CheckBox {
                                        text: "Afficher le texte du message";
                                        enabled: root.notifications-on;
                                        checked <=> root.notif-preview;
                                        toggled => {
                                            root.notif-changed();
                                        }
                                    }
                                    CheckBox {
                                        text: "Jouer un son";
                                        enabled: root.notifications-on;
                                        checked <=> root.notif-sound;
                                        toggled => {
                                            root.notif-changed();
                                        }
                                    }
                                    CheckBox {
                                        text: "Même quand la discussion est ouverte à l'écran";
                                        enabled: root.notifications-on;
                                        checked <=> root.notif-when-focused;
                                        toggled => {
                                            root.notif-changed();
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    Button {
                                        text: "Tester une notification";
                                        enabled: root.notifications-on;
                                        clicked => {
                                            root.notif-test();
                                        }
                                    }
                                    Text {
                                        text: "« Ne pas déranger » coupe toutes les notifications. Réglages fins (bannières, son, écran verrouillé) : Paramètres Windows → Système → Notifications → MagicPlus.";
                                        color: Theme.subtle;
                                        font-size: 11.5px;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Cet appareil";
                                }
                                Text {
                                    text: "Pseudo";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Subtle {
                                    text: "Votre nom pour les autres : ils le voient dès qu'ils détectent cet appareil, avant même l'association.";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text <=> root.pseudo-edit;
                                        placeholder-text: "ex. Léa";
                                        horizontal-stretch: 1;
                                        accepted(value) => {
                                            root.save-pseudo(value);
                                        }
                                    }
                                    Button {
                                        text: "Enregistrer";
                                        clicked => {
                                            root.save-pseudo(root.pseudo-edit);
                                        }
                                    }
                                }
                                Text {
                                    text: "Nom de l'appareil";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Subtle {
                                    text: "Le nom de cet ordinateur, affiché à côté du pseudo.";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        text <=> root.name-edit;
                                        horizontal-stretch: 1;
                                        accepted(value) => {
                                            root.save-name(value);
                                        }
                                    }
                                    Button {
                                        text: "Enregistrer";
                                        enabled: root.name-edit != "" && root.name-edit != root.device-name;
                                        clicked => {
                                            root.save-name(root.name-edit);
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Réception des fichiers";
                                }
                                Subtle {
                                    text: (root.save-folder == "" ? "Dossier de réception (par défaut) :  " : "Dossier de réception :  ") + root.receive-folder;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button {
                                        text: "Choisir un dossier…";
                                        clicked => {
                                            root.choose-folder();
                                        }
                                    }
                                    Button {
                                        text: "Ne plus utiliser de dossier";
                                        enabled: root.save-folder != "";
                                        clicked => {
                                            root.clear-folder();
                                        }
                                    }
                                }
                                Subtle {
                                    text: "Les fichiers arrivent par petits morceaux dans un dossier caché, puis sont rangés ici une fois complets et vérifiés. Un transfert interrompu (Wi-Fi coupé, ordinateur en veille ou éteint) reprend tout seul là où il s'était arrêté.";
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "Reprise possible pendant :";
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        model: ["1 heure", "6 heures", "12 heures", "24 heures", "48 heures", "3 jours", "7 jours"];
                                        current-index <=> root.resume-index;
                                        width: 160px;
                                        selected(value) => {
                                            root.resume-changed(self.current-index);
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Presse-papiers";
                                }
                                CheckBox {
                                    text: "Mettre automatiquement le texte reçu dans le presse-papiers";
                                    checked <=> root.auto-copy;
                                    toggled => {
                                        root.auto-copy-changed(self.checked);
                                    }
                                }
                                Subtle {
                                    text: "Activé : copiez sur l'autre appareil (ou Ctrl + Shift + Alt + C), puis collez directement ici.";
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Démarrage et notifications";
                                }
                                CheckBox {
                                    text: "Lancer MagicPlus à l'ouverture de la session (en arrière-plan, dans la zone de notification)";
                                    checked <=> root.launch-at-login;
                                    toggled => {
                                        root.launch-at-login-changed(self.checked);
                                    }
                                }
                                CheckBox {
                                    text: "Afficher une notification à chaque message ou demande d'ami reçus";
                                    checked <=> root.notifications-on;
                                    toggled => {
                                        root.notifications-changed(self.checked);
                                    }
                                }
                                Subtle {
                                    text: "Fermer la fenêtre ne quitte pas MagicPlus : il reste joignable par vos autres appareils et vous prévient des messages. Pour le quitter : clic droit sur son icône près de l'horloge → Quitter MagicPlus.";
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "Mises à jour";
                                }
                                Text {
                                    text: root.update-text;
                                    color: Theme.text;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                                CheckBox {
                                    text: "Chercher automatiquement les nouvelles versions (seul usage d'Internet)";
                                    checked <=> root.update-auto;
                                    toggled => {
                                        root.update-auto-changed(self.checked);
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    if root.update-action != "": Button {
                                        text: root.update-action;
                                        primary: true;
                                        clicked => {
                                            root.update-act();
                                        }
                                    }
                                    Button {
                                        text: "Voir les nouveautés";
                                        clicked => {
                                            root.show-news();
                                        }
                                    }
                                    Button {
                                        text: "Rechercher maintenant";
                                        enabled: !root.update-busy;
                                        clicked => {
                                            root.update-check();
                                        }
                                    }
                                    if root.update-has-page: Button {
                                        text: "Page de la version";
                                        clicked => {
                                            root.update-open-page();
                                        }
                                    }
                                }
                            }

                            Card {
                                SectionTitle {
                                    text: "À propos";
                                }
                                Subtle {
                                    text: "MagicPlus " + root.version + "  ·  Aucun serveur, aucun compte : tout reste sur votre réseau local. Découverte UDP 45454, transferts TCP 45455.";
                                }
                            }
                        }
                    }
                }
            }
        }

        // ------------------------------------------------ barre d'état
        Rectangle {
            height: 30px;
            background: Theme.nav;
            border-width: 0px;

            Rectangle {
                height: 1px;
                y: 0px;
                background: Theme.card-border;
            }
            Text {
                x: 16px;
                width: parent.width - 240px;
                height: parent.height;
                text: root.status;
                color: Theme.subtle;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: parent.width - 220px;
                width: 204px;
                height: parent.height;
                text: root.paired-count + " appareil(s) associé(s)";
                color: Theme.subtle;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    // ------------------------------------------------ boîte de dialogue d'association
    if root.pairing-open: Rectangle {
        background: #00000099;

        TouchArea { }

        Card {
            width: min(480px, parent.width - 48px);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.dark ? #2d2d2d : #ffffff;

            Text {
                text: root.pairing-peer.key-changed ? "Associer à nouveau « " + root.pairing-peer.name + " » ?" : "Associer « " + root.pairing-peer.name + " » ?";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.pairing-peer.key-changed: Text {
                text: "Attention : cet appareil avait déjà été associé mais annonce maintenant une autre clé. Ne continuez que si vous avez réinstallé MagicPlus sur cette machine.";
                color: Theme.danger;
                font-size: 13px;
                wrap: word-wrap;
            }
            Subtle {
                text: "Vérifiez que cette empreinte est strictement identique à celle affichée sur l'autre appareil (page Appareils, ligne « cet appareil »). Sinon, quelqu'un d'autre se fait passer pour lui.";
            }
            Rectangle {
                background: Theme.bubble;
                border-radius: 6px;
                height: 52px;
                Text {
                    text: root.pairing-peer.fingerprint;
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 600;
                    font-family: "Menlo";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Annuler";
                    clicked => {
                        root.pairing-open = false;
                    }
                }
                Button {
                    text: "L'empreinte est identique : associer";
                    primary: true;
                    clicked => {
                        root.pairing-open = false;
                        root.trust(root.pairing-peer.id);
                    }
                }
            }
        }
    }

    // ------------------------------------------------ surnom d'un appareil
    if root.alias-open: Rectangle {
        background: #00000099;
        TouchArea { }
        Card {
            width: min(440px, parent.width - 48px);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.dark ? #2d2d2d : #ffffff;
            Text {
                text: "Surnom pour « " + root.alias-peer.device-name + " »";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Subtle {
                text: "Visible seulement sur cet appareil. " + (root.alias-peer.pseudo != "" ? "Son pseudo : « " + root.alias-peer.pseudo + " ». " : "") + "Laissez vide pour revenir à son nom.";
            }
            LineEdit {
                text <=> root.alias-edit;
                placeholder-text: "Surnom";
                accepted(value) => {
                    root.alias-open = false;
                    root.set-alias(root.alias-peer.id, value);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Annuler";
                    clicked => {
                        root.alias-open = false;
                    }
                }
                Button {
                    text: "Enregistrer";
                    primary: true;
                    clicked => {
                        root.alias-open = false;
                        root.set-alias(root.alias-peer.id, root.alias-edit);
                    }
                }
            }
        }
    }

    // ------------------------------------------------ profil en grand
    if ChatData.full-open: Rectangle {
        background: #000000aa;
        TouchArea {
            clicked => {
                ChatData.full-open = false;
            }
        }
        full-scroll := ScrollView {
            width: min(560px, parent.width - 32px);
            height: min(full-view.preferred-height, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            content-height: full-view.preferred-height;
            full-view := FullProfileView {
                width: full-scroll.visible-width;
                item: ChatData.full;
                action(code) => {
                    ChatData.full-action(code);
                }
                view-picture(which) => {
                    ChatData.full-action(10 + which);
                }
                open-group(id) => {
                    ChatData.open-group(id);
                }
                link-clicked(url) => {
                    ChatData.open-link(url);
                }
            }
        }
    }

    // ------------------------------------------------ image en grand
    if ChatData.viewer-open: ImageViewer {
        width: parent.width;
        height: parent.height;
        item: ChatData.viewer;
        close => {
            ChatData.viewer-open = false;
        }
        open-file(path) => {
            ChatData.open-path(path);
        }
        reveal(path) => {
            ChatData.reveal-path(path);
        }
    }

    // ------------------------------------------------ envoyer à…
    if root.send-open: Rectangle {
        background: #00000099;
        TouchArea { }
        Card {
            width: min(420px, parent.width - 32px);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.dark ? #2d2d2d : #ffffff;
            Text {
                text: root.send-title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            Subtle {
                text: "Choisissez les appareils qui le reçoivent.";
            }
            for target[index] in root.send-targets: CheckBox {
                text: target.name;
                checked: target.checked;
                toggled => {
                    root.send-toggle(index, self.checked);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Annuler";
                    clicked => {
                        root.send-open = false;
                    }
                }
                Button {
                    text: "Envoyer";
                    primary: true;
                    clicked => {
                        root.send-open = false;
                        root.send-confirm();
                    }
                }
            }
        }
    }

    // ------------------------------------------------ recadrage
    if root.crop-open: Rectangle {
        background: #00000099;
        TouchArea { }
        Card {
            width: min(500px, parent.width - 32px);
            height: self.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.dark ? #2d2d2d : #ffffff;
            Text {
                text: root.crop-banner ? "Recadrer la bannière" : "Recadrer la photo de profil";
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
            }
            Subtle {
                text: "Réglez le zoom et la partie de l'image à garder. Elle n'est jamais étirée." + (root.crop-animated ? " Le GIF restera animé (aperçu de la première image)." : "");
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.crop-banner ? 420px : 220px;
                    height: root.crop-banner ? 168px : 220px;
                    border-radius: root.crop-banner ? 8px : 110px;
                    clip: true;
                    Image {
                        source: root.crop-preview;
                        width: parent.width;
                        height: parent.height;
                        image-fit: fill;
                    }
                }
            }
            for row in [{ name: "Zoom", index: 0 }, { name: "Gauche ↔ droite", index: 1 }, { name: "Haut ↔ bas", index: 2 }]: HorizontalLayout {
                spacing: 10px;
                Text {
                    text: row.name;
                    color: Theme.text;
                    width: 120px;
                    vertical-alignment: center;
                }
                Slider {
                    minimum: row.index == 0 ? 1 : 0;
                    maximum: row.index == 0 ? 4 : 1;
                    value: row.index == 0 ? root.crop-zoom : row.index == 1 ? root.crop-x : root.crop-y;
                    changed(value) => {
                        if row.index == 0 {
                            root.crop-zoom = value;
                        } else if row.index == 1 {
                            root.crop-x = value;
                        } else {
                            root.crop-y = value;
                        }
                        root.crop-changed();
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Annuler";
                    clicked => {
                        root.crop-open = false;
                    }
                }
                Button {
                    text: "Enregistrer";
                    primary: true;
                    clicked => {
                        root.crop-open = false;
                        root.crop-apply();
                    }
                }
            }
        }
    }

    // ------------------------------------------------ nouveautés
    if root.news-open: Rectangle {
        background: #00000099;
        TouchArea { }
        Card {
            width: min(520px, parent.width - 32px);
            height: min(self.preferred-height, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.dark ? #2d2d2d : #ffffff;
            Text {
                text: root.news-title;
                color: Theme.text;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            news-scroll := ScrollView {
                min-height: 120px;
                preferred-height: min(news-view.preferred-height, 380px);
                content-height: news-view.preferred-height;
                news-view := MarkdownView {
                    width: news-scroll.visible-width - 12px;
                    blocks: root.news-blocks;
                    font-size: 13px;
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Super !";
                    primary: true;
                    clicked => {
                        root.news-open = false;
                    }
                }
            }
        }
    }

    // ------------------------------------------------ boîtes de dialogue des discussions
    if ChatData.dialog != 0: ChatDialog {
        width: parent.width;
        height: parent.height;
    }
}
