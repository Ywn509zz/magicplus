// Couleurs de l'interface Slint (Windows 11 / Fluent), en thème clair ou sombre.

import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> mica: dark ? #202020 : #f3f3f3;
    out property <color> nav: dark ? #1b1b1b : #ececec;
    out property <color> nav-hover: dark ? #ffffff10 : #00000009;
    out property <color> nav-selected: dark ? #ffffff17 : #00000012;
    out property <color> card: dark ? #2b2b2b : #fbfbfb;
    out property <color> card-border: dark ? #3a3a3a : #e3e3e3;
    out property <color> bubble: dark ? #383838 : #eaeaea;
    out property <color> text: dark ? #ffffff : #1a1a1a;
    out property <color> subtle: dark ? #a8a8a8 : #5f5f5f;
    out property <color> accent: dark ? #60cdff : #0067c0;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> neutral: dark ? #b0b0b0 : #6b6b6b;
    // Discussions
    out property <color> chat-bg: dark ? #272727 : #fcfcfc;
    out property <color> list-bg: dark ? #202020 : #f3f3f3;
    out property <color> row-hover: dark ? #ffffff08 : #00000006;
    out property <color> mine-bubble: dark ? #0f3a57 : #d9ebfa;
    out property <color> badge: dark ? #e0434f : #c42b1c;
    out property <color> popup: dark ? #2c2c2c : #ffffff;
}
