// Profils, comme sur Discord : photo ronde, bannière (image ou couleur), pronoms, « À propos ».

import { Button } from "std-widgets.slint";
import { Theme, Anim } from "theme.slint";
import { MarkdownView, BlockItem } from "markdown.slint";

export struct ProfileItem {
    id: string,
    name: string,
    pronouns: string,
    bio: [BlockItem],
    has-bio: bool,
    banner: image,
    banner-frames: [image],
    banner-frame-ms: int,
    has-banner: bool,
    banner-color: color,
    photo: image,
    photo-frames: [image],
    photo-frame-ms: int,
    has-photo: bool,
    initials: string,
    color: color,
    me: bool,
    can-chat: bool,
}

// Pastille de présence, comme Discord : verte (en ligne), lune jaune (inactif), rouge barrée
// (ne pas déranger), anneau gris (hors ligne ou invisible).
export component PresenceDot inherits Rectangle {
    in property <int> presence;
    in property <length> size: 12px;
    in property <color> ring: Theme.list-bg;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.ring;

    Rectangle {
        width: root.size - 5px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.presence == 1 ? #23a55a : root.presence == 2 ? #f0b232 : root.presence == 3 ? #f23f43 : #80848e;
    }
    // Inactif : lune (un disque de la couleur du fond mange le coin).
    if root.presence == 2: Rectangle {
        x: root.size * 0.18;
        y: root.size * 0.18;
        width: (root.size - 5px) * 0.62;
        height: self.width;
        border-radius: self.width / 2;
        background: root.ring;
    }
    // Ne pas déranger : trait blanc.
    if root.presence == 3: Rectangle {
        width: (root.size - 5px) * 0.6;
        height: Math.max(1.5px, (root.size - 5px) * 0.22);
        border-radius: self.height / 2;
        background: root.ring;
    }
    // Hors ligne : anneau.
    if root.presence == 0: Rectangle {
        width: (root.size - 5px) * 0.45;
        height: self.width;
        border-radius: self.width / 2;
        background: root.ring;
    }
}

// Photo de profil ronde, ou pastille colorée avec les initiales.
export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 38px;
    in property <image> photo;
    in property <bool> has-photo;
    // Photo animée (GIF) : ses images, et si elle s'anime maintenant (dans les messages,
    // seulement au survol, comme Discord).
    in property <[image]> frames;
    in property <int> frame-ms: 100;
    in property <bool> animate: true;
    in property <bool> show-presence;
    in property <bool> online;
    // Présence : -1 d'après `online` ; 0 hors ligne, 1 en ligne, 2 inactif, 3 ne pas déranger.
    in property <int> presence: -1;
    property <int> shown-presence: root.presence >= 0 ? root.presence : root.online ? 1 : 0;
    in property <color> ring: Theme.list-bg;
    width: root.size;
    height: root.size;

    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: root.tint;
        clip: true;

        if !root.has-photo: Text {
            text: root.initials;
            color: #ffffff;
            font-size: root.size * 0.38;
            font-weight: 600;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.has-photo: Image {
            source: root.animate && root.frames.length > 1 ? root.frames[Math.mod(Math.floor(Anim.tick * 50 / Math.max(root.frame-ms, 20)), root.frames.length)] : root.photo;
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }
    }

    if root.show-presence: PresenceDot {
        size: root.size * 0.36;
        x: parent.width - self.width + 1px;
        y: parent.height - self.height + 1px;
        presence: root.shown-presence;
        ring: root.ring;
    }
}

// Carte de profil : bannière, photo qui déborde, nom, pronoms, « À propos de moi ».
// Les enfants (boutons) se placent sous le texte.
export component ProfileCard inherits Rectangle {
    in property <ProfileItem> profile;
    in property <length> card-width: 300px;
    callback link-clicked(string);
    width: root.card-width;
    preferred-height: layout.preferred-height;
    min-height: layout.min-height;
    background: Theme.popup;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    layout := VerticalLayout {
        Rectangle {
            height: root.card-width * 0.4 + 44px;

            Rectangle {
                y: 0px;
                height: root.card-width * 0.4;
                background: root.profile.banner-color;
                clip: true;
                if root.profile.has-banner: Image {
                    source: root.profile.banner-frames.length > 1 ? root.profile.banner-frames[Math.mod(Math.floor(Anim.tick * 50 / Math.max(root.profile.banner-frame-ms, 20)), root.profile.banner-frames.length)] : root.profile.banner;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
            }

            Rectangle {
                x: 14px;
                y: parent.height - 88px;
                width: 88px;
                height: 88px;
                border-radius: 44px;
                background: Theme.popup;
                Avatar {
                    x: 4px;
                    y: 4px;
                    size: 80px;
                    initials: root.profile.initials;
                    tint: root.profile.color;
                    photo: root.profile.photo;
                    has-photo: root.profile.has-photo;
                    frames: root.profile.photo-frames;
                    frame-ms: root.profile.photo-frame-ms;
                }
            }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 14px;
            spacing: 4px;
            Text {
                text: root.profile.name;
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            if root.profile.pronouns != "": Text {
                text: root.profile.pronouns;
                color: Theme.subtle;
                font-size: 12px;
            }
            if root.profile.has-bio: Rectangle {
                height: 1px;
                background: Theme.card-border;
            }
            if root.profile.has-bio: Text {
                text: "À PROPOS DE MOI";
                color: Theme.subtle;
                font-size: 10.5px;
                font-weight: 700;
            }
            if root.profile.has-bio: MarkdownView {
                blocks: root.profile.bio;
                font-size: 12.5px;
                link-clicked(url) => {
                    root.link-clicked(url);
                }
            }
            @children
        }
    }
}

export struct GroupLink {
    id: string,
    name: string,
}

// Profil en grand (comme sur Discord).
export struct FullProfileItem {
    profile: ProfileItem,
    // « pseudo · appareil · plateforme · en ligne »
    identity: string,
    online: bool,
    fingerprint: string,
    groups: [GroupLink],
    can-message: bool,
    // 0 rien, 1 « Ajouter en ami », 2 demande envoyée, 3 « Accepter sa demande »
    friend-action: int,
}

export component FullProfileView inherits Rectangle {
    in property <FullProfileItem> item;
    // 1 message, 2 ajouter en ami, 3 accepter, 4 modifier mon profil
    callback action(int);
    callback open-group(string);
    callback link-clicked(string);
    callback close();
    property <length> banner-height: 224px;
    background: Theme.popup;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    VerticalLayout {
        Rectangle {
            height: root.banner-height + 70px;

            Rectangle {
                y: 0px;
                height: root.banner-height;
                background: root.item.profile.banner-color;
                clip: true;
                if root.item.profile.has-banner: Image {
                    source: root.item.profile.banner;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
            }

            Rectangle {
                x: 22px;
                y: parent.height - 140px;
                width: 140px;
                height: 140px;
                border-radius: 70px;
                background: Theme.popup;
                Avatar {
                    x: 6px;
                    y: 6px;
                    size: 128px;
                    initials: root.item.profile.initials;
                    tint: root.item.profile.color;
                    photo: root.item.profile.photo;
                    has-photo: root.item.profile.has-photo;
                    show-presence: true;
                    online: root.item.online;
                    ring: Theme.popup;
                }
            }

            HorizontalLayout {
                x: 180px;
                y: root.banner-height + 14px;
                width: parent.width - 200px;
                height: 40px;
                alignment: end;
                spacing: 8px;
                if root.item.profile.me: Button {
                    text: "Modifier mon profil";
                    primary: true;
                    clicked => {
                        root.action(4);
                    }
                }
                if root.item.can-message: Button {
                    text: "Envoyer un message";
                    primary: true;
                    clicked => {
                        root.action(1);
                    }
                }
                if root.item.friend-action == 1: Button {
                    text: "Ajouter en ami";
                    clicked => {
                        root.action(2);
                    }
                }
                if root.item.friend-action == 2: Button {
                    text: "Demande d'ami envoyée";
                    enabled: false;
                }
                if root.item.friend-action == 3: Button {
                    text: "Accepter sa demande d'ami";
                    primary: true;
                    clicked => {
                        root.action(3);
                    }
                }
            }
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 12px;
            padding-bottom: 20px;
            spacing: 6px;
            Text {
                text: root.item.profile.name;
                color: Theme.text;
                font-size: 26px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.item.identity;
                color: Theme.subtle;
                font-size: 13px;
                overflow: elide;
            }
            if root.item.profile.pronouns != "": Text {
                text: root.item.profile.pronouns;
                color: Theme.text;
                font-size: 13px;
            }
            if root.item.profile.has-bio: Rectangle {
                height: 1px;
                background: Theme.card-border;
            }
            if root.item.profile.has-bio: Text {
                text: "À PROPOS DE MOI";
                color: Theme.subtle;
                font-size: 11px;
                font-weight: 700;
            }
            if root.item.profile.has-bio: MarkdownView {
                blocks: root.item.profile.bio;
                font-size: 14px;
                link-clicked(url) => {
                    root.link-clicked(url);
                }
            }
            if root.item.groups.length > 0: Rectangle {
                height: 1px;
                background: Theme.card-border;
            }
            if root.item.groups.length > 0: Text {
                text: "GROUPES EN COMMUN — " + root.item.groups.length;
                color: Theme.subtle;
                font-size: 11px;
                font-weight: 700;
            }
            for group in root.item.groups: Rectangle {
                height: 30px;
                border-radius: 6px;
                background: group-touch.has-hover ? Theme.accent.with-alpha(0.14) : transparent;
                group-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-group(group.id);
                    }
                }
                Text {
                    x: 8px;
                    text: "👥  " + (group.name == "" ? "Groupe" : group.name);
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.card-border;
            }
            Text {
                text: "APPAREIL";
                color: Theme.subtle;
                font-size: 11px;
                font-weight: 700;
            }
            Text {
                text: "Empreinte  " + root.item.fingerprint;
                color: Theme.subtle;
                font-size: 12px;
            }
        }
    }
}
